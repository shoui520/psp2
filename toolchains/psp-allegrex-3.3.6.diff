+
+int
+mips_use_ins_ext_p (op, size, pos)
+     rtx op;
+     rtx size;
+     rtx pos;
+{
+  if (!ISA_HAS_EXT_INS)
+    return 0;
+  if (GET_CODE (op) != REG && GET_CODE (op) != SUBREG)
+    return 0;
+  if (GET_MODE (op) != SImode)
+    return 0;
+  if (GET_CODE (size) != CONST_INT || GET_CODE (pos) != CONST_INT)
+    return 0;
+  if (INTVAL (size) <= 0 || INTVAL (pos) < 0 || INTVAL (pos) + INTVAL (size) > 32)
+    return 0;
+  return 1;
+}
