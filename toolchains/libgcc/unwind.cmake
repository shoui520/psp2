# Build the SCE adaptation without changing the pristine upstream file.
function(gcc48_prepare_unwind upstream output)
	file(READ "${upstream}" source)
	set(restore_start "  if ((vrs->demand_save_flags & DEMAND_SAVE_WMMXD)")
	set(restore_end "\n}\n\n#include \"unwind-arm-common.inc\"")
	string(FIND "${source}" "${restore_start}" begin)
	string(FIND "${source}" "${restore_end}" end)
	if(begin LESS 0 OR end LESS begin)
		message(FATAL_ERROR "Pinned GCC WMMX restore markers missing")
	endif()
	math(EXPR size "${end} - ${begin}")
	string(SUBSTRING "${source}" 0 ${begin} prefix)
	string(SUBSTRING "${source}" ${begin} ${size} operations)
	string(SUBSTRING "${source}" ${end} -1 suffix)
	set(source "${prefix}/* SCE: PSP2 does not restore WMMX state. */\n#ifndef SCE_NO_WMMX\n${operations}\n#endif${suffix}")

	set(pop_start "/* ABI defined function to pop registers off the stack.  */")
	string(FIND "${source}" "${pop_start}" pop)
	if(pop LESS 0)
		message(FATAL_ERROR "Pinned GCC VRS Pop marker missing")
	endif()
	string(SUBSTRING "${source}" 0 ${pop} prefix)
	string(SUBSTRING "${source}" ${pop} -1 body)
	string(FIND "${body}" "    case _UVRSC_WMMXD:" begin)
	string(FIND "${body}" "    default:" end)
	if(begin LESS 0 OR end LESS begin)
		message(FATAL_ERROR "Pinned GCC WMMX Pop markers missing")
	endif()
	math(EXPR size "${end} - ${begin}")
	string(SUBSTRING "${body}" 0 ${begin} before)
	string(SUBSTRING "${body}" ${begin} ${size} operations)
	string(SUBSTRING "${body}" ${end} -1 after)
	file(WRITE "${output}" "#include \"unwind_config.h\"\n${prefix}${before}/* SCE: unsupported WMMX classes use the failure case below. */\n#ifndef SCE_NO_WMMX\n${operations}#endif\n${after}")
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream}")
endfunction()
