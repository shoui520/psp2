void main(float4 position : POSITION,
	  float4 texcoord0 : TEXCOORD0,
	  float2 texcoord1 : TEXCOORD1,
	  uniform float4x4 MVP,
	  uniform float4 Region0,
	  uniform float4 Region1,
	  out float4 oPosition : POSITION,
	  out float4 oTexcoord0 : TEXCOORD0,
	  out float2 oTexcoord1 : TEXCOORD1)
{
	oPosition = mul(float4(position.xyz, 1), MVP);
	oTexcoord0.xy = texcoord0.xy * Region0.zw + Region0.xy;
	oTexcoord0.zw = texcoord0.zw * Region1.zw + Region1.xy;
	oTexcoord1 = texcoord1;
}
