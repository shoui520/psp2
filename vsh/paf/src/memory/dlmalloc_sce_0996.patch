+/* SCE: count and sum all chunks in a treebin subtree */
+static void report_tree_free_blocks(mstate ms, bindex_t idx, tchunkptr t,
+                                    unsigned int* count, size_t* total) {
+  tchunkptr u = t;
+  do {
+    if (u->parent != 0) {
+      if (u->child[0] != 0) {
+        ++(*count);
+        *total += chunksize(u->child[0]);
+        report_tree_free_blocks(ms, idx, u->child[0], count, total);
+      }
+      if (u->child[1] != 0) {
+        ++(*count);
+        *total += chunksize(u->child[1]);
+        report_tree_free_blocks(ms, idx, u->child[1], count, total);
+      }
+    }
+    u = u->fd;
+  } while (u != t);
+}
+
+/* SCE: hand every free block to handler(chunk, size, count, arg) */
+unsigned int mspace_report_free_blocks(mspace msp,
+                                       int (*handler)(void*, size_t, int, void*),
+                                       void* arg) {
+  mstate ms = (mstate)msp;
+  unsigned int n = 1;
+  bindex_t i;
+  if (handler(ms->top, chunksize(ms->top), 1, arg) == 0)
+    return n;
+  for (i = 0; i < NTREEBINS; ++i) {
+    tbinptr* h = treebin_at(ms, i);
+    tchunkptr t = *h;
+    if (treemap_is_marked(ms, i)) {
+      size_t total = chunksize(t);
+      unsigned int count = 1;
+      report_tree_free_blocks(ms, i, t, &count, &total);
+      n += count;
+      if (handler(t, total, (int)count, arg) == 0)
+        return n;
+    }
+  }
+  for (i = 0; i < NSMALLBINS; ++i) {
+    sbinptr b = smallbin_at(ms, i);
+    mchunkptr p = b->bk;
+    if (smallmap_is_marked(ms, i)) {
+      while (p != b) {
+        ++n;
+        if (handler(p, chunksize(p), 1, arg) == 0)
+          return n;
+        p = p->bk;
+      }
+    }
+  }
+  return n;
+}
+
+/*
+  SCE: 1 when the padding after the request was overwritten, or mem's foot
+  does not hold tag, or the space is not valid; 0 otherwise.
+*/
+int mspace_check_memorybounds(mspace msp, void* mem, unsigned int tag) {
+  mstate ms = (mstate)msp;
+  mchunkptr p;
+  if (ms == 0 || mem == 0)
+    return 0;
+  p = mem2chunk(mem);
+  if (p->head & FLAG4_BIT) {
+    unsigned char* e;
+    size_t n, i;
+    p->head &= ~FLAG4_BIT;
+    e = (unsigned char*)chunk_plus_offset(p, chunksize(p));
+    n = e[-1] ^ 0xFF;
+    if (n > CHUNK_ALIGN_MASK - 1)
+      return 1;
+    for (i = 1; i <= n; ++i) {
+      if (e[-1 - (int)i] != PADDING_BYTE)
+        return 1;
+    }
+  }
+  if (foot_tag(p) != tag || !ok_magic(ms))
+    return 1;
+  return 0;
+}
+
+/* SCE: chunk size of mem */
+size_t mspace_ptr_get_size(mspace msp, const void* mem) {
+  (void)msp;
+  return chunksize(mem2chunk(mem));
+}
+
+/* SCE: tag held in mem's foot */
+unsigned int mspace_ptr_get_tag(const void* mem) {
+  return foot_tag(mem2chunk(mem));
+}
