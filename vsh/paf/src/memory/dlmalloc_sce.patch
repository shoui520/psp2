+/* SCE: unlink a chunk from the address-ordered bin */
+static void unlink_large_large_chunk(mstate m, tchunkptr x) {
+  tchunkptr xp = x->parent;
+  tbinptr* h = treebin_at(m, x->index);
+  tchunkptr r;
+  if (x->bk != x) {
+    CORRUPTION_ERROR_ACTION(m);
+    return;
+  }
+  if (x->child[0] != 0 || x->child[1] != 0) {
+    if (x->child[0] == 0)
+      r = x->child[1];
+    else if (x->child[1] == 0)
+      r = x->child[0];
+    else {
+      /* replace x with its predecessor in address order */
+      tchunkptr* rp = &(x->child[0]);
+      tchunkptr* cp;
+      tchunkptr c;
+      r = *rp;
+      while (*(cp = &(r->child[1])) != 0)
