/* paf::allocator: the paf heap behind every paf container. */
#ifndef PAF_STD_ALLOCATOR
#define PAF_STD_ALLOCATOR

#include <stddef.h>
#include <std/new>
#include <std/stdlib.h>

namespace paf {

template<class _Ty>
class allocator {
public:
	typedef _Ty value_type;
	typedef _Ty *pointer;
	typedef size_t size_type;

	allocator()
	{
	}

	allocator(const allocator &)
	{
	}

	pointer allocate(size_type count)
	{
		return (pointer)operator new(count * sizeof(_Ty));
	}

	void deallocate(pointer ptr, size_type)
	{
		operator delete(ptr);
	}

	void construct(pointer ptr, const _Ty &val)
	{
		new ((void *)ptr) _Ty(val);
	}

	/* a failed allocate, as the containers that take an allocator report it: paf's
	   heap reports it, an allocator of its own need not (name ours) */
	void report_failure()
	{
		ScePafStdc_D608246A();
	}
};

}

#endif
