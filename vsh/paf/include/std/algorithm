/* paf::for_each, paf::min and paf::max (Dinkumware's <algorithm>). */
#ifndef PAF_STD_ALGORITHM
#define PAF_STD_ALGORITHM

namespace paf {

template<class _InIt, class _Fn1>
inline _Fn1 for_each(_InIt _First, _InIt _Last, _Fn1 _Func)
{
	for (; _First != _Last; ++_First)
		_Func(*_First);
	return _Func;
}

template<class _Ty>
inline const _Ty &min(const _Ty &left, const _Ty &right)
{
	return right < left ? right : left;
}

template<class _Ty>
inline const _Ty &max(const _Ty &left, const _Ty &right)
{
	return left < right ? right : left;
}

}

#endif
