/*
 * paf::copy, paf::for_each, paf::find_if, paf::lower_bound, paf::min and paf::max (Dinkumware's
 * <algorithm>), and
 * paf::sort, which is not Dinkumware's: a quicksort around the first element that turns to a
 * heapsort past 16 levels (libpaf's build of the draw layers' entries, 0x8121fce8 TOOL).
 */
#ifndef PAF_STD_ALGORITHM
#define PAF_STD_ALGORITHM

#include <stddef.h>

namespace paf {

template<class _InIt, class _OutIt>
inline _OutIt copy(_InIt _First, _InIt _Last, _OutIt _Dest)
{
	for (; _First != _Last; ++_Dest, ++_First)
		*_Dest = *_First;
	return _Dest;
}

template<class _InIt, class _Fn1>
inline _Fn1 for_each(_InIt _First, _InIt _Last, _Fn1 _Func)
{
	for (; _First != _Last; ++_First)
		_Func(*_First);
	return _Func;
}

template<class _InIt, class _Pr>
inline _InIt find_if(_InIt _First, _InIt _Last, _Pr _Pred)
{
	for (; _First != _Last; ++_First)
		if (_Pred(*_First))
			break;
	return _First;
}

/* the first element of the sorted [_First, _Last) not ordered before _Val (Dinkumware's) */
template<class _FwdIt, class _Ty>
inline _FwdIt lower_bound(_FwdIt _First, _FwdIt _Last, const _Ty &_Val)
{
	ptrdiff_t _Count = _Last - _First;

	for (; 0 < _Count;) {
		ptrdiff_t _Count2 = _Count / 2;
		_FwdIt _Mid = _First + _Count2;

		if (*_Mid < _Val) {
			_First = ++_Mid;
			_Count -= _Count2 + 1;
		} else {
			_Count = _Count2;
		}
	}
	return _First;
}

/* libpaf calls each of its instantiations out of line (the list view's) */
template<class _FwdIt, class _Ty, class _Pr>
inline __attribute__((noinline)) _FwdIt lower_bound(_FwdIt _First, _FwdIt _Last, const _Ty &_Val,
						     _Pr _Pred)
{
	ptrdiff_t _Count = _Last - _First;

	for (; 0 < _Count;) {
		ptrdiff_t _Count2 = _Count / 2;
		_FwdIt _Mid = _First + _Count2;

		if (_Pred(*_Mid, _Val)) {
			_First = ++_Mid;
			_Count -= _Count2 + 1;
		} else {
			_Count = _Count2;
		}
	}
	return _First;
}

template<class _Ty>
inline const _Ty &min(const _Ty &left, const _Ty &right)
{
	return right < left ? right : left;
}

template<class _Ty>
inline const _Ty &max(const _Ty &left, const _Ty &right)
{
	return left < right ? right : left;
}

template<class _Ty>
inline void swap(_Ty &left, _Ty &right)
{
	_Ty tmp = left;

	left = right;
	right = tmp;
}

/* [_First, _Last) made a heap, and the heap sorted (the names Dinkumware's) */
template<class _RanIt>
inline void _Make_heap(_RanIt _First, _RanIt _Last)
{
	/* the heap counted from 1: element k's parent is k / 2 */
	if (_Last - _First >= 2) {
		_RanIt _Next = _First + 2;
		_RanIt _Mid;

		do {
			_RanIt _Base = _First + -1;
			size_t _Idx = _Next - _First;

			while (_Idx >= 2) {
				size_t _Parent = _Idx >> 1;

				if (!(*(_Base + _Parent) < *(_Base + _Idx)))
					break;
				swap(*(_Base + _Parent), *(_Base + _Idx));
				_Idx = _Parent;
			}
			_Mid = _Next;
			++_Next;
		} while (_Mid != _Last);
	}
}

template<class _RanIt>
inline void _Sort_heap(_RanIt _First, _RanIt _Last)
{
	if (_Last - _First >= 2) {
		while (_First != _Last + -1) {
			_RanIt _Base = _First;
			size_t _Size = _Last - _First;

			if (_Size >= 2) {
				swap(*_First, *(_Last + -1));
				_Size--;
				--_Base;

				size_t _Hole = 1;

				for (size_t _Idx = 2; _Idx <= _Size; _Idx *= 2) {
					if (_Idx < _Size && *(_Base + _Idx) < *(_Base + _Idx + 1))
						_Idx++;
					if (!(*(_Base + _Hole) < *(_Base + _Idx)))
						break;
					swap(*(_Base + _Hole), *(_Base + _Idx));
					_Hole = _Idx;
				}
			}
			--_Last;
		}
	}
}

/* [_First, _Last) sorted by <, _Depth levels of quicksort left before the heapsort (the
   parameters' names Dinkumware's, the function ours) */
template<class _RanIt>
void _Sort(_RanIt _First, _RanIt _Last, int _Depth)
{
	if (_First == _Last)
		return;

	if (--_Depth <= 0) {
		_Make_heap(_First, _Last);
		_Sort_heap(_First, _Last);
	} else {
		--_Last;

		_RanIt _Lo = _First;
		_RanIt _Hi = _Last;

		for (;;) {
			while (*_Lo < *_First)
				++_Lo;
			while (*_First < *_Hi)
				--_Hi;
			if (!(_Lo < _Hi))
				break;
			swap(*_Lo, *_Hi);
			++_Lo;
			--_Hi;
		}
		if (_First < _Lo + -1)
			_Sort(_First, _Lo, _Depth);
		if (_Hi + 1 < _Last)
			_Sort(_Hi + 1, _Last + 1, _Depth);
	}
}

template<class _RanIt>
inline void sort(_RanIt _First, _RanIt _Last)
{
	_Sort(_First, _Last, 16);
}

/* the same with the order given by _Pred (the list view's cells) */
template<class _RanIt, class _Pr>
inline void _Make_heap(_RanIt _First, _RanIt _Last, _Pr _Pred)
{
	if (_Last - _First >= 2) {
		_RanIt _Next = _First + 2;
		_RanIt _Mid;

		do {
			_RanIt _Base = _First + -1;
			size_t _Idx = _Next - _First;

			while (_Idx >= 2) {
				size_t _Parent = _Idx >> 1;

				if (!_Pred(*(_Base + _Parent), *(_Base + _Idx)))
					break;
				swap(*(_Base + _Parent), *(_Base + _Idx));
				_Idx = _Parent;
			}
			_Mid = _Next;
			++_Next;
		} while (_Mid != _Last);
	}
}

template<class _RanIt, class _Pr>
inline void _Sort_heap(_RanIt _First, _RanIt _Last, _Pr _Pred)
{
	if (_Last - _First >= 2) {
		while (_First != _Last + -1) {
			_RanIt _Base = _First;
			size_t _Size = _Last - _First;

			if (_Size >= 2) {
				swap(*_First, *(_Last + -1));
				_Size--;
				--_Base;

				size_t _Hole = 1;

				for (size_t _Idx = 2; _Idx <= _Size; _Idx *= 2) {
					if (_Idx < _Size && _Pred(*(_Base + _Idx), *(_Base + _Idx + 1)))
						_Idx++;
					if (!_Pred(*(_Base + _Hole), *(_Base + _Idx)))
						break;
					swap(*(_Base + _Hole), *(_Base + _Idx));
					_Hole = _Idx;
				}
			}
			--_Last;
		}
	}
}

template<class _RanIt, class _Pr>
void _Sort(_RanIt _First, _RanIt _Last, _Pr _Pred, int _Depth)
{
	if (_First == _Last)
		return;

	if (--_Depth <= 0) {
		_Make_heap(_First, _Last, _Pred);
		_Sort_heap(_First, _Last, _Pred);
	} else {
		--_Last;

		_RanIt _Lo = _First;
		_RanIt _Hi = _Last;

		for (;;) {
			while (_Pred(*_Lo, *_First))
				++_Lo;
			while (_Pred(*_First, *_Hi))
				--_Hi;
			if (!(_Lo < _Hi))
				break;
			swap(*_Lo, *_Hi);
			++_Lo;
			--_Hi;
		}
		if (_First < _Lo + -1)
			_Sort(_First, _Lo, _Pred, _Depth);
		if (_Hi + 1 < _Last)
			_Sort(_Hi + 1, _Last + 1, _Pred, _Depth);
	}
}

template<class _RanIt, class _Pr>
inline void sort(_RanIt _First, _RanIt _Last, _Pr _Pred)
{
	_Sort(_First, _Last, _Pred, 16);
}

}

#endif
