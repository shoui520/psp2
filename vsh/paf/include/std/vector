/*
 * paf::vector: a counted array on the paf heap. It grows by ten elements at a
 * time and copies its elements over when it does.
 */
#ifndef PAF_STD_VECTOR
#define PAF_STD_VECTOR

#include <stddef.h>
#include <std/allocator>
#include <std/stdlib.h>

/* libpaf's build makes the allocator constructor out of line, as Sony's does */
#ifdef PAF_LIBRARY_BUILD
#define PAF_VECTOR_NOINLINE	__attribute__((noinline))
#else
#define PAF_VECTOR_NOINLINE
#endif

namespace paf {

template<class _Ty, class _Ax = allocator<_Ty> >
class vector {
public:
	typedef vector<_Ty, _Ax> _Myt;
	typedef size_t size_type;
	typedef ptrdiff_t difference_type;

	/* moves only while it points somewhere */
	class iterator {
	public:
		iterator() : m_ptr(NULL)
		{
		}

		iterator(_Ty *ptr) : m_ptr(ptr)
		{
		}

		iterator(const iterator &right) : m_ptr(right.m_ptr)
		{
		}

		_Ty &operator*() const
		{
			return *m_ptr;
		}

		_Ty *operator->() const
		{
			return m_ptr;
		}

		iterator &operator++()
		{
			if (m_ptr != NULL)
				++m_ptr;
			return *this;
		}

		iterator &operator--()
		{
			if (m_ptr != NULL)
				--m_ptr;
			return *this;
		}

		iterator operator+(difference_type off) const
		{
			iterator result(m_ptr);

			if (m_ptr != NULL)
				result.m_ptr += off;
			return result;
		}

		difference_type operator-(const iterator &right) const
		{
			return m_ptr - right.m_ptr;
		}

		bool operator==(const iterator &right) const
		{
			return m_ptr == right.m_ptr;
		}

		bool operator!=(const iterator &right) const
		{
			return m_ptr != right.m_ptr;
		}

		bool operator<(const iterator &right) const
		{
			return m_ptr < right.m_ptr;
		}

		_Ty *m_ptr;
	};

	vector()
	{
		ptr = NULL;
		count = 0;
		limit = 0;
	}

	/* how a vector kept in a global is made; libpaf's build calls it out of line wherever
	   it is used */
	explicit PAF_VECTOR_NOINLINE vector(const _Ax &al) : alloc(al)
	{
		ptr = NULL;
		limit = 0;
		count = 0;
	}

	explicit vector(size_type size)
	{
		count = 0;
		limit = 0;

		_Ty *buffer = alloc.allocate(size);

		if (buffer == NULL)
			alloc.report_failure();
		ptr = buffer;
		if (buffer != NULL) {
			count = size;
			limit = size;
			for (size_type i = 0; i < count; ++i)
				new (&ptr[i]) _Ty();
		}
	}

	/* Sony's build calls it out of line */
	__attribute__((noinline)) vector(size_type size, const _Ty &val, const _Ax &al = _Ax())
		: alloc(al)
	{
		count = 0;
		limit = 0;

		_Ty *buffer = alloc.allocate(size);

		if (buffer == NULL)
			alloc.report_failure();
		ptr = buffer;
		if (buffer != NULL) {
			count = size;
			limit = size;
			for (size_type i = 0; i < count; ++i)
				new (&ptr[i]) _Ty(val);
		}
	}

	vector(const _Myt &src);

	~vector();

	_Myt &operator=(const _Myt &src)
	{
		_Myt(src).swap(*this);
		return *this;
	}

	void swap(_Myt &other)
	{
		_Ty *old_ptr = ptr;
		int old_count = count;

		count = other.count;
		ptr = other.ptr;
		other.count = old_count;
		other.ptr = old_ptr;

		int old_limit = limit;

		limit = other.limit;
		other.limit = old_limit;

		_Ax old_alloc = alloc;

		alloc = other.alloc;
		other.alloc = old_alloc;
	}

	bool reserve(size_type size);
	void resize(size_type size, _Ty val = _Ty());

	void clear()
	{
		if (ptr != NULL) {
			for (size_type i = 0; i < count; ++i)
				ptr[i].~_Ty();
			alloc.deallocate(ptr, limit);
			ptr = NULL;
			count = 0;
			limit = 0;
		}
	}

	int push_back(const _Ty &val);

	/* gives back ten elements whenever twenty are spare */
	void pop_back()
	{
		if (count != 0) {
			ptr[count - 1].~_Ty();
			--count;
			if (count < limit - 20)
				reserve(limit - 10);
		}
	}

	_Ty &back()
	{
		return ptr[size() - 1];
	}

	_Ty &operator[](size_type pos)
	{
		return ptr[pos];
	}

	const _Ty &operator[](size_type pos) const
	{
		return ptr[pos];
	}

	/* reports a position past the end, then reads it anyway */
	_Ty &at(size_type pos)
	{
		if (pos >= count)
			ScePafStdc_D608246A();
		return ptr[pos];
	}

	iterator begin()
	{
		return iterator(ptr);
	}

	iterator end()
	{
		return iterator(ptr + count);
	}

	iterator insert(const iterator &where, const _Ty &val);
	iterator erase(const iterator &first, const iterator &last);

	iterator erase(iterator where)
	{
		return erase(where, where + 1);
	}

	size_type capacity() const
	{
		return limit;
	}

	size_type size() const
	{
		return count;
	}

	bool empty() const
	{
		return count == 0;
	}

	_Ty *ptr;
	int count;
	int limit;
	_Ax alloc;
};

template<class _Ty, class _Ax>
vector<_Ty, _Ax>::vector(const _Myt &src) : alloc(src.alloc)
{
	count = 0;
	limit = 0;

	_Ty *data = alloc.allocate(src.limit);

	if (data == NULL)
		alloc.report_failure();
	ptr = data;
	if (data != NULL) {
		count = src.count;
		limit = src.limit;
		for (size_type i = 0; i < count; ++i)
			new (&ptr[i]) _Ty(src.ptr[i]);
	}
}

template<class _Ty, class _Ax>
vector<_Ty, _Ax>::~vector()
{
	if (ptr != NULL) {
		for (size_type i = count; i != 0; --i)
			ptr[i - 1].~_Ty();
		alloc.deallocate(ptr, limit);
	}
	ptr = (_Ty *)-1;
	count = -1;
	limit = -1;
}

template<class _Ty, class _Ax>
bool
vector<_Ty, _Ax>::reserve(size_type size)
{
	if (ptr == NULL) {
		_Ty *data = alloc.allocate(size);

		if (data == NULL)
			alloc.report_failure();
		ptr = data;
		if (data == NULL)
			return false;
		limit = size;
		return true;
	}

	_Ty *dst = alloc.allocate(size);

	if (dst == NULL) {
		alloc.report_failure();
		return false;
	}
	for (size_type i = 0; i < count; ++i)
		alloc.construct(&dst[i], ptr[i]);
	for (size_type i = 0; i < count; ++i)
		ptr[i].~_Ty();
	alloc.deallocate(ptr, limit);
	ptr = dst;
	limit = size;
	return true;
}

/* Shrinking gives back ten elements whenever twenty are spare; growing adds tens. */
template<class _Ty, class _Ax>
void
vector<_Ty, _Ax>::resize(size_type size, _Ty val)
{
	if (size < count) {
		int newlimit = limit;

		while (size < count) {
			ptr[count - 1].~_Ty();
			--count;
			if (count < newlimit - 20)
				newlimit -= 10;
		}
		if (limit != newlimit)
			reserve(newlimit);
	} else if (size > count) {
		size_type newlimit = limit;

		while (newlimit < size)
			newlimit += 10;
		size_type first = count;

		if (limit != newlimit) {
			bool reserved = reserve(newlimit);

			first = count;
			if (!reserved)
				return;
		}
		for (size_type i = first; i < size; ++i)
			alloc.construct(&ptr[i], val);
		count = size;
	}
}

/*
 * The array grows by ten when full; the last element is copied one up and the rest
 * move up to where, which takes the value. A failed growth returns end().
 */
template<class _Ty, class _Ax>
typename vector<_Ty, _Ax>::iterator
vector<_Ty, _Ax>::insert(const iterator &where, const _Ty &val)
{
	size_type off = 0;

	if (count != 0)
		off = where - begin();

	bool grown = true;

	if (count + 1 > limit)
		grown = reserve(limit + 10);
	if (grown) {
		if (count != 0) {
			new (&ptr[count]) _Ty(ptr[count - 1]);
			for (size_type i = count - 1; i > off; --i)
				ptr[i] = ptr[i - 1];
			ptr[off] = val;
		} else {
			new (&ptr[count]) _Ty(val);
		}
		++count;
	} else {
		off = count;
	}
	return begin() + off;
}

/* The elements after last move down and the ones left over at the end are destroyed; the array
   shrinks by ten once twenty are spare. */
template<class _Ty, class _Ax>
typename vector<_Ty, _Ax>::iterator
vector<_Ty, _Ax>::erase(const iterator &first, const iterator &last)
{
	difference_type off = first - begin();
	size_type src = last - begin();
	size_type erased = src - off;

	for (size_type dst = off; src < count; ++src, ++dst)
		ptr[dst] = ptr[src];
	for (size_type i = count - erased; i < count; ++i)
		ptr[i].~_Ty();
	count -= erased;
	if (count < limit - 20)
		reserve(limit - 10);
	return begin() + off;
}

template<class _Ty, class _Ax>
inline int
vector<_Ty, _Ax>::push_back(const _Ty &val)
{
	int result;

	if (count + 1 <= limit || (result = reserve(limit + 10)) != 0) {
		new (&ptr[count]) _Ty(val);
		result = ++count;
	}
	return result;
}

}

#endif
