/*
 * paf::list: a doubly linked ring of nodes on the paf heap around a head node
 * that holds no value.
 */
#ifndef PAF_STD_LIST
#define PAF_STD_LIST

#include <stddef.h>
#include <std/allocator>
#include <std/stdlib.h>

namespace paf {

template<class _Ty, class _Ax = allocator<_Ty> >
class list {
public:
	typedef list<_Ty, _Ax> _Myt;
	typedef size_t size_type;

	struct _Node {
		_Node *prev;
		_Node *next;
		_Ty value;
	};

	class iterator {
	public:
		iterator(_Node *where) : node(where)
		{
		}

		iterator(const iterator &other) : node(other.node)
		{
		}

		iterator &operator=(const iterator &other)
		{
			node = other.node;
			return *this;
		}

		_Ty &operator*() const
		{
			return node->value;
		}

		_Ty *operator->() const
		{
			return &node->value;
		}

		iterator &operator++()
		{
			if (node != NULL)
				node = node->next;
			return *this;
		}

		iterator operator++(int)
		{
			iterator tmp = *this;

			++*this;
			return tmp;
		}

		bool operator==(const iterator &other) const
		{
			return node == other.node;
		}

		bool operator!=(const iterator &other) const
		{
			return node != other.node;
		}

		_Node *node;
	};

	/* through a pointer, so a polymorphic value is destroyed virtually */
	static void destroy(_Ty *ptr)
	{
		ptr->~_Ty();
	}

	explicit list(const _Ax &al = _Ax()) : alloc(al)
	{
		count = 0;

		_Node *node = (_Node *)operator new(sizeof(_Node));

		if (node == NULL)
			ScePafStdc_D608246A();
		head = node;
		if (head != NULL) {
			head->prev = head;
			head->next = head;
		}
	}

	list(const list &other);

	~list();

	iterator begin()
	{
		return iterator(head != NULL ? head->next : NULL);
	}

	iterator end()
	{
		return iterator(head);
	}

	_Ty &front()
	{
		return head->next->value;
	}

	_Ty &back()
	{
		return head->prev->value;
	}

	void push_back(const _Ty &val);

	iterator erase(iterator where);

	void remove(const _Ty &val);

	void pop_front()
	{
		_Node *node = head->next;

		if (head != NULL) {
			node->next->prev = node->prev;
			node->prev->next = node->next;
			destroy(&node->value);
			operator delete(node);
			--count;
		}
	}

	void pop_back()
	{
		if (count != 0 && head != NULL) {
			_Node *node = head->prev;

			node->next->prev = node->prev;
			node->prev->next = node->next;
			destroy(&node->value);
			operator delete(node);
			--count;
		}
	}

	size_type size() const
	{
		return count;
	}

	_Node *head;
	size_type count;
	_Ax alloc;
};

template<class _Ty, class _Ax>
list<_Ty, _Ax>::list(const list &other)
{
	count = 0;

	_Node *node = (_Node *)operator new(sizeof(_Node));

	if (node == NULL)
		ScePafStdc_D608246A();
	head = node;
	if (node != NULL) {
		_Node *tail = node;
		_Node *src = other.head != NULL ? other.head->next : NULL;

		while (src != other.head) {
			_Node *copy = (_Node *)operator new(sizeof(_Node));

			if (copy != NULL) {
				new (&copy->value) _Ty(src->value);
			} else {
				ScePafStdc_D608246A();
				copy = head;
			}
			if (copy == head)
				break;
			copy->prev = tail;
			tail->next = copy;
			tail = copy;
			++count;
			if (src != NULL)
				src = src->next;
		}
		tail->next = head;
		head->prev = tail;
	}
}

template<class _Ty, class _Ax>
list<_Ty, _Ax>::~list()
{
	if (head != NULL) {
		_Node *node = head->next;

		if (node != head) {
			do {
				_Node *next = node->next;

				destroy(&node->value);
				operator delete(node);
				node = next;
			} while (node != head);
		}
		operator delete(head);
	}
	head = (_Node *)-1;
	count = (size_type)-1;
}

template<class _Ty, class _Ax>
void
list<_Ty, _Ax>::push_back(const _Ty &val)
{
	if (head == NULL)
		return;

	_Node *node = (_Node *)operator new(sizeof(_Node));

	if (node == NULL)
		ScePafStdc_D608246A();
	if (node != NULL)
		new (&node->value) _Ty(val);
	else
		node = head;
	if (node != head) {
		node->prev = head->prev;
		node->next = head;
		head->prev->next = node;
		head->prev = node;
		++count;
	}
}

template<class _Ty, class _Ax>
typename list<_Ty, _Ax>::iterator
list<_Ty, _Ax>::erase(iterator where)
{
	_Node *node = where.node;
	_Node *next = node->next;

	node->next->prev = node->prev;
	node->prev->next = node->next;
	destroy(&node->value);
	operator delete(node);
	--count;
	return iterator(next);
}

/* Sony's build calls remove rather than inlining it. */
template<class _Ty, class _Ax>
__attribute__((noinline)) void
list<_Ty, _Ax>::remove(const _Ty &val)
{
	_Node *node = begin().node;

	while (node != head) {
		if (node->value == val) {
			_Node *prev = node->prev;
			_Node *next = node->next;

			next->prev = prev;
			prev->next = node->next;
			destroy(&node->value);
			operator delete(node);
			--count;
			node = next;
		} else if (node != NULL) {
			node = node->next;
		}
	}
}

}

#endif
