/*
 * paf::list: a doubly linked ring of nodes on the paf heap around a head node
 * that holds no value. Its iterator is paf::_list_iterator (the exports that take one name
 * it: AttributedString::GetStyleRuns, ui::Environment::GetSceneTop).
 */
#ifndef PAF_STD_LIST
#define PAF_STD_LIST

#include <stddef.h>
#include <std/allocator>
#include <std/stdlib.h>

namespace paf {

/* a node of the ring: the head node's value is never constructed */
template<class _Ty>
struct _list_node {
	_list_node *prev;
	_list_node *next;
	_Ty value;
};

template<class _Ty, class _Ax = allocator<_Ty> >
class _list_iterator {
public:
	typedef _list_node<_Ty> _Node;

	_list_iterator() : node(NULL)
	{
	}

	_list_iterator(_Node *where) : node(where)
	{
	}

	_list_iterator(const _list_iterator &other) : node(other.node)
	{
	}

	_list_iterator &operator=(const _list_iterator &other)
	{
		node = other.node;
		return *this;
	}

	_Ty &operator*() const
	{
		return node->value;
	}

	_Ty *operator->() const
	{
		return &node->value;
	}

	_list_iterator &operator++()
	{
		if (node != NULL)
			node = node->next;
		return *this;
	}

	_list_iterator &operator--()
	{
		if (node != NULL)
			node = node->prev;
		return *this;
	}

	_list_iterator operator++(int)
	{
		_list_iterator tmp = *this;

		++*this;
		return tmp;
	}

	bool operator==(const _list_iterator &other) const
	{
		return node == other.node;
	}

	bool operator!=(const _list_iterator &other) const
	{
		return node != other.node;
	}

	_Node *node;
};

template<class _Ty, class _Ax = allocator<_Ty> >
class list {
public:
	typedef list<_Ty, _Ax> _Myt;
	typedef size_t size_type;

	typedef _list_node<_Ty> _Node;
	typedef _list_iterator<_Ty, _Ax> iterator;

	/* through a pointer, so a polymorphic value is destroyed virtually */
	static void destroy(_Ty *ptr)
	{
		ptr->~_Ty();
	}

	explicit list(const _Ax &al = _Ax()) : alloc(al)
	{
		count = 0;

		_Node *node = (_Node *)operator new(sizeof(_Node));

		if (node == NULL)
			ScePafStdc_D608246A();
		head = node;
		if (head != NULL) {
			head->prev = head;
			head->next = head;
		}
	}

	list(const list &other);

	~list();

	_Myt &operator=(const _Myt &src)
	{
		_Myt(src).swap(*this);
		return *this;
	}

	void swap(_Myt &other)
	{
		_Node *old_head = head;

		head = other.head;
		other.head = old_head;

		size_type old_count = count;

		count = other.count;
		other.count = old_count;
	}

	iterator begin()
	{
		return iterator(head != NULL ? head->next : NULL);
	}

	iterator end()
	{
		return iterator(head);
	}

	iterator begin() const
	{
		return iterator(head != NULL ? head->next : NULL);
	}

	iterator end() const
	{
		return iterator(head);
	}

	_Ty &front()
	{
		return head->next->value;
	}

	_Ty &back()
	{
		return head->prev->value;
	}

	void push_front(const _Ty &val);

	void push_back(const _Ty &val);

	iterator insert(iterator where, const _Ty &val);

	iterator erase(iterator where);

	void remove(const _Ty &val);

	void pop_front();

	/* the node at first moved from right to before where */
	void splice(iterator where, _Myt &right, iterator first)
	{
		if (where != first) {
			iterator last = first;

			++last;
			_Splice(where, right, first, last, 1);
		}
	}

	/* all of right's nodes moved to before where */
	void splice(iterator where, _Myt &right)
	{
		if (right.count != 0)
			_Splice(where, right, right.begin(), right.end(), right.count);
	}

	/* the nodes from first to last moved from right to before where; num of them, counted
	   where it is 0 */
	void _Splice(const iterator &where, _Myt &right, const iterator &first, const iterator &last,
		     size_type num);

	void pop_back()
	{
		if (head != NULL) {
			_Node *node = head->prev;

			node->next->prev = node->prev;
			node->prev->next = node->next;
			destroy(&node->value);
			operator delete(node);
			--count;
		}
	}

	void clear()
	{
		if (head != NULL) {
			_Node *node = head->next;

			while (node != head) {
				_Node *next = node->next;

				destroy(&node->value);
				operator delete(node);
				node = next;
			}
			head->prev = head;
			head->next = head;
			count = 0;
		}
	}

	size_type size() const
	{
		return count;
	}

	_Node *head;
	size_type count;
	_Ax alloc;
};

template<class _Ty, class _Ax>
list<_Ty, _Ax>::list(const list &other)
{
	count = 0;

	_Node *node = (_Node *)operator new(sizeof(_Node));

	if (node == NULL)
		ScePafStdc_D608246A();
	head = node;
	if (node != NULL) {
		_Node *tail = node;
		_Node *src = other.head != NULL ? other.head->next : NULL;

		while (src != other.head) {
			_Node *copy = (_Node *)operator new(sizeof(_Node));

			if (copy == NULL)
				ScePafStdc_D608246A();
			if (copy != NULL)
				new (&copy->value) _Ty(src->value);
			else
				copy = head;
			if (copy == head)
				break;
			copy->prev = tail;
			tail->next = copy;
			tail = copy;
			++count;
			if (src != NULL)
				src = src->next;
		}
		tail->next = head;
		head->prev = tail;
	}
}

/* the destructor body; also the inline destructor of the element types Sony keeps no
   out-of-line copy for (PAF_LIST_INLINE_DTOR) */
#define PAF_LIST_DESTROY_ALL \
	if (head != NULL) { \
		_Node *node = head->next; \
 \
		if (node != head) { \
			do { \
				_Node *next = node->next; \
 \
				destroy(&node->value); \
				operator delete(node); \
				node = next; \
			} while (node != head); \
		} \
		operator delete(head); \
	} \
	head = (_Node *)-1; \
	count = (size_type)-1;

template<class _Ty, class _Ax>
list<_Ty, _Ax>::~list()
{
	PAF_LIST_DESTROY_ALL
}

template<class _Ty, class _Ax>
void
list<_Ty, _Ax>::pop_front()
{
	if (count != 0 && head != NULL) {
		_Node *node = head->next;

		node->next->prev = node->prev;
		node->prev->next = node->next;
		destroy(&node->value);
		operator delete(node);
		--count;
	}
}

template<class _Ty, class _Ax>
void
list<_Ty, _Ax>::push_front(const _Ty &val)
{
	if (head == NULL)
		return;

	_Node *node = (_Node *)operator new(sizeof(_Node));

	if (node == NULL)
		ScePafStdc_D608246A();
	if (node != NULL)
		new (&node->value) _Ty(val);
	else
		node = head;
	if (node != head) {
		node->prev = head;
		node->next = head->next;

		_Node *first = head;
		size_type size = count + 1;

		first->next->prev = node;
		first->next = node;
		count = size;
	}
}

template<class _Ty, class _Ax>
void
list<_Ty, _Ax>::push_back(const _Ty &val)
{
	if (head == NULL)
		return;

	_Node *node = (_Node *)operator new(sizeof(_Node));

	if (node == NULL)
		ScePafStdc_D608246A();
	if (node != NULL)
		new (&node->value) _Ty(val);
	else
		node = head;
	if (node != head) {
		node->prev = head->prev;
		node->next = head;
		head->prev->next = node;
		head->prev = node;
		++count;
	}
}

template<class _Ty, class _Ax>
void
list<_Ty, _Ax>::_Splice(const iterator &where, _Myt &right, const iterator &first,
			const iterator &last, size_type num)
{
	_Node *fnode = first.node;
	size_type moved = num;
	_Node *lnode = last.node;

	if (num == 0) {
		for (iterator it = first; it.node != lnode; ++it)
			++moved;
	}

	iterator tail = last;

	--tail;
	fnode->prev->next = lnode;
	lnode->prev = fnode->prev;

	_Node *wnode = where.node;

	wnode->prev->next = fnode;
	fnode->prev = wnode->prev;
	wnode->prev = tail.node;
	tail.node->next = wnode;
	right.count -= moved;
	count += moved;
}

/* Sony's build calls insert rather than inlining it. */
template<class _Ty, class _Ax>
__attribute__((noinline)) typename list<_Ty, _Ax>::iterator
list<_Ty, _Ax>::insert(iterator where, const _Ty &val)
{
	_Node *next = where.node;
	_Node *node = (_Node *)operator new(sizeof(_Node));

	if (node != NULL) {
		new (&node->value) _Ty(val);
	} else {
		ScePafStdc_D608246A();
		node = head;
	}
	if (node != head) {
		node->prev = next->prev;
		node->next = next;
		next->prev->next = node;
		next->prev = node;
		++count;
	}
	return iterator(node);
}

template<class _Ty, class _Ax>
typename list<_Ty, _Ax>::iterator
list<_Ty, _Ax>::erase(iterator where)
{
	_Node *node = where.node;
	_Node *next = node->next;

	node->next->prev = node->prev;
	node->prev->next = node->next;
	destroy(&node->value);
	operator delete(node);
	--count;
	return iterator(next);
}

/* Sony's build calls remove rather than inlining it. */
template<class _Ty, class _Ax>
__attribute__((noinline)) void
list<_Ty, _Ax>::remove(const _Ty &val)
{
	_Node *node = begin().node;

	while (node != head) {
		if (node->value == val) {
			_Node *prev = node->prev;
			_Node *next = node->next;

			next->prev = prev;
			prev->next = node->next;
			destroy(&node->value);
			operator delete(node);
			--count;
			node = next;
		} else if (node != NULL) {
			node = node->next;
		}
	}
}

}

/* list<T>::~list inline, at namespace scope after T: Sony inlines it everywhere */
#define PAF_LIST_INLINE_DTOR(T) \
	namespace paf { \
	template<> inline list<T, allocator<T> >::~list() \
	{ \
		PAF_LIST_DESTROY_ALL \
	} \
	}

/* pointer element types Sony's code inlines the destructor of everywhere */
namespace paf {
class TimerListener;
class TemplateCache;
namespace ui { class Widget; }
namespace graph { class ScreenCopyObj; }
}
PAF_LIST_INLINE_DTOR(ui::Widget *)
PAF_LIST_INLINE_DTOR(TimerListener *)
PAF_LIST_INLINE_DTOR(graph::ScreenCopyObj *)

/* list<string>: inlined everywhere, emitted by whichever of <std/list> and <std/string> comes second */
#ifdef PAF_STD_STRING
PAF_LIST_INLINE_DTOR(string)
#endif

#endif
