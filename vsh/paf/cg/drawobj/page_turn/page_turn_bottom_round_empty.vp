/*
 * The empty space under the turning page, with a rounded corner: flat, and shadowed by its
 * distance from the fold; the corner coordinates run from -1 to 1 across the page.
 */
struct Shape {
	float4 FoldPlane;
	float4 Aspect;
};

struct VertexInput {
	float4 pos : POSITION;
};

void main(VertexInput vin,
	  uniform float4x4 MVP,
	  uniform float4 Shadow,
	  uniform float4 UVTransform,
	  uniform float4 SqueezeZ,
	  uniform Shape shape,
	  out float4 oPosition : POSITION,
	  out half3 oTexcoord : TEXCOORD0,
	  out half2 oCorner : TEXCOORD1)
{
	float4 position = float4(SqueezeZ.xy * vin.pos.xy, SqueezeZ.zw * float2(0, 1));
	float2 uv = shape.Aspect.zw * vin.pos.xy;
	float fold = dot(shape.FoldPlane.zw, vin.pos.xy - shape.FoldPlane.xy);
	float shade = exp(-Shadow.z * abs(fold));

	oPosition = mul(position, MVP);
	oCorner = uv * 2 - 1;
	uv.y = 1 - uv.y;
	oTexcoord.xy = uv * UVTransform.xy + UVTransform.zw;
	oTexcoord.z = lerp(1, Shadow.w, shade);
}
