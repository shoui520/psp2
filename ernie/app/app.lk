SEG	@@KICYC	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KIFLG	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KENAD	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KACT	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KDISD	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KDLY	ALIGN 2 IF ERNIE_HW==0x00723030
