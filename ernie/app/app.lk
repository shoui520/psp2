SEG	@@KMKRDY	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KQINS	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KHOOK	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KTRSE	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KTRSX	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KTRIE	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KTRIX	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KTRTS	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KTRD	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KTMINS	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KTMREM	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KWAIT	ALIGN 2 IF ERNIE_HW==0x00723030
AT	0x0d5fe		IF ERNIE_FW>=0x00090903&&ERNIE_KERNEL!=0x00411000&&ERNIE_HW!=0x00723030	# where kernel.asm reads it (CONFIG)
AT	0x0d608		IF ERNIE_HW==0x00723030
AT	0x0d878		IF ERNIE_FW<=0x00090804&&ERNIE_FW>=0x00080307||ERNIE_FW<0x00080302||ERNIE_FW>=0x00080302&&ERNIE_FW<0x00080307&&ERNIE_HW!=0x00102003||ERNIE_FW>0x00090804&&ERNIE_KERNEL==0x00411000	# 0x00411000 keeps 0x00090804's kernel
AT	0x0d55e		IF ERNIE_FW>=0x00080302&&ERNIE_FW<0x00080307&&ERNIE_HW==0x00102003	# 0x00080302: no ref_ services
SEG	@@KCFG

# the startup, the runtime, the interrupts, the flash library and the C library's functions,
# then the constants
AT	0x0e000
FILL	none		IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000	# (the gaps up to 0xe000 0x00 too)
SEG	@@CSTART
SEG	@@RTCODE
SEG	@@BASE
SEG	@@FSLCOD
SEG	@@LCODE
SEG	@@FSLOPN
# the constants start where Sony's do: the code before them is a few bytes shorter than
# Sony's (handlers that are proven or reviewed, not exact), and the constants' page breaks
# must fall as Sony's do
AT	0x0f6f6		IF ERNIE_BOARD==0x00415000&&ERNIE_FW==0x01000306
AT	0x0f6f6		IF ERNIE_BOARD==0x00411000&&ERNIE_FW==0x01000306&&ERNIE_HW!=0x00102603&&ERNIE_HW!=0x00315200
