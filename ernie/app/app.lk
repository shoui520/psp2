# The application's link (tools/lk78k0r.py): its objects in link order, then where their
# segments go, as Sony's image has them. Boot cluster 0 (0x0000-0x0fff: the vectors, the
# configuration's defaults at 0x800, the version block at 0xf00), the kernel from 0xc000, the
# rest from 0xe000 to 0x353ff; the RAM the updater keeps (0xfd900) first.

OBJECT	main.c
OBJECT	tau.c
OBJECT	standby.c
OBJECT	task1.c
OBJECT	task2.c
OBJECT	version.c
OBJECT	rtc.c
OBJECT	task3.c
OBJECT	input.c
OBJECT	aes.c
OBJECT	host.c
OBJECT	request.c
OBJECT	csi.c
OBJECT	sleepfactor.c
OBJECT	spidev.c
OBJECT	command.c
OBJECT	uart.c
OBJECT	clockout.c
OBJECT	csi10.c
OBJECT	dma.c
OBJECT	touch.c
OBJECT	inputreq.c
OBJECT	csi01.c		IF ERNIE_FW<0x0100060B	# BOARD_MOTION
OBJECT	motion.c	IF ERNIE_FW<0x0100060B
OBJECT	util.c
OBJECT	inputbits.c
OBJECT	serial.c
OBJECT	adc.c
OBJECT	analog.c
OBJECT	scratchpad.c
OBJECT	nvsreq.c
OBJECT	serial1.c
OBJECT	updatereq.c
OBJECT	sha1.c
OBJECT	powerreq.c
OBJECT	task5.c
# the serial authentication's keys: their own object, before serialauth.c's tables (since
# 0x0100060B all the keys, after led.c)
OBJECT	authkeys.c	IF ERNIE_FW<0x0100060B
OBJECT	serialauth.c
OBJECT	nvs.c
OBJECT	power.c
# the flash library's settings come here in Sony's link: in the constants' page, after
# power.c's and before uart4.c's (fslConfig fills the page's end before uart4Bauds)
OBJECT	../lib/fsl.asm
OBJECT	timer.c
OBJECT	iica.c
OBJECT	powerjob.c
OBJECT	elmo.c
OBJECT	serial2.c
OBJECT	uart4.c		IF ERNIE_BOARD!=0x00406000||ERNIE_HW==0x00601000	# BOARD_SERIAL4
OBJECT	interrupt.c
OBJECT	serial4.c
OBJECT	task6.c
OBJECT	bbmc.c
OBJECT	trace.c
OBJECT	board.c
OBJECT	powerseq.c
OBJECT	battery.c
OBJECT	charge.c
OBJECT	cookie.c
OBJECT	powerwait.c
OBJECT	state.c
OBJECT	handshake.c
OBJECT	serial1op.c
OBJECT	task.c
# before 0x01000104 the configuration's defaults are among the constants, before config.c's
OBJECT	configdefault.c	IF ERNIE_FW<0x01000104&&ERNIE_FW>=0x00090804	# 0x00090206 has no defaults
OBJECT	config.c
OBJECT	configreq.c
OBJECT	watchdog.c	IF ERNIE_FW>=0x00090009
OBJECT	sysinfo.c
OBJECT	log.c		IF ERNIE_FW>=0x00090804
# param.c's constants follow log.c's in Sony's link (its code is placed before config.c's)
OBJECT	param.c
# 0x00090206 has no power LED fade: its LED is powerseq.c's powerLedSet
OBJECT	led.c		IF ERNIE_FW>=0x00090804
OBJECT	authkeys.c	IF ERNIE_FW>=0x0100060B
OBJECT	serialreq.c	IF ERNIE_FW>=0x00090903
OBJECT	snvs.c		IF ERNIE_FW>=0x00090903
OBJECT	debugpin.c	IF ERNIE_FW>=0x0100060B
OBJECT	gf.c		IF ERNIE_FW<0x0100060B
OBJECT	aestable.c	IF ERNIE_FW>=0x0100060B
OBJECT	configdefault.c	IF ERNIE_FW>=0x01000104
OBJECT	kernel.asm
OBJECT	kernelcfg.asm
OBJECT	cstart.asm
OBJECT	vectors.asm
# the CA78K0R libraries' modules it uses
OBJECT	../lib/lucom.asm
OBJECT	../lib/iumul.asm
OBJECT	../lib/lumul.asm
OBJECT	../lib/cudiv.asm
OBJECT	../lib/iudiv.asm	IF ERNIE_FW>=0x00090903
OBJECT	../lib/curem.asm
OBJECT	../lib/luadd.asm
OBJECT	../lib/lulsh.asm
OBJECT	../lib/lursh.asm
OBJECT	../lib/iscmp.asm
OBJECT	../lib/lscmp.asm	IF ERNIE_FW<0x01000306
OBJECT	../lib/luband.asm
OBJECT	../lib/lubor.asm
OBJECT	../lib/lubxor.asm
OBJECT	../lib/divuw.asm
OBJECT	../lib/fslinfo.asm
OBJECT	../lib/fslwrite.asm
OBJECT	../lib/fslsecurity.asm
OBJECT	../lib/fslflags.asm
OBJECT	../lib/fslswap.asm
OBJECT	../lib/memcpy.asm
OBJECT	../lib/memcpy_n.asm	IF ERNIE_FW>=0x01000107
OBJECT	../lib/memmove.asm	IF ERNIE_FW>=0x00090804	# log.c's
OBJECT	../lib/memcmp.asm
OBJECT	../lib/memset.asm
OBJECT	../lib/memset_n.asm
OBJECT	../lib/fslopen.asm
# the ends of the startup's segments, after everything
OBJECT	cstartend.asm

# the compiler's runtime registers
SYMBOL	_@SEGAX		0xffed4
SYMBOL	_@SEGBC		0xffed5
SYMBOL	_@SEGDE		0xffed6
SYMBOL	_@SEGHL		0xffed7
SYMBOL	_@RTARG0	0xffed8
SYMBOL	_@RTARG1	0xffed9
SYMBOL	_@RTARG2	0xffeda
SYMBOL	_@RTARG3	0xffedb
SYMBOL	_@RTARG4	0xffedc
SYMBOL	_@RTARG5	0xffedd
SYMBOL	_@RTARG6	0xffede
SYMBOL	_@RTARG7	0xffedf
# and as the libraries' and the kernel's modules name them
SYMBOL	@SEGAX		0xffed4
SYMBOL	@SEGBC		0xffed5
SYMBOL	@SEGDE		0xffed6
SYMBOL	@SEGHL		0xffed7
SYMBOL	@RTARG0		0xffed8
SYMBOL	@RTARG2		0xffeda
SYMBOL	@RTARG4		0xffedc
SYMBOL	@RTARG6		0xffede
RESERVE	0xffed4		12
# the settings' two banks in the flash, which neither program's image holds
SYMBOL	_configBanks	0x3b800

# the interrupts' vectors are vectors.asm's table, not the compiler's
DROP	@@VECT??

# boot cluster 0: the vectors, the CALLT table and the option bytes, the configuration's
# defaults ("ConfZZ"), the version block
AT	0x00000
SEG	@@VECT
AT	0x00200	IF ERNIE_FW>=0x0100060B	# aes.c's round tables
SEG	@@CNSTL		aestable.c IF ERNIE_FW>=0x0100060B
AT	0x00800	IF ERNIE_FW>=0x01000104
SEG	@@CNSTL		configdefault.c IF ERNIE_FW>=0x01000104
AT	0x00f00
SEG	@@CNSTL		version.c

# the kernel and its configuration
AT	0x0c000
SEG	@@KERNEL
AT	0x0d5fe		IF ERNIE_FW>=0x00090903&&ERNIE_KERNEL!=0x00411000	# where kernel.asm reads it (CONFIG)
AT	0x0d878		IF ERNIE_FW<=0x00090804||ERNIE_KERNEL==0x00411000	# 0x00411000 keeps 0x00090804's kernel
SEG	@@KCFG

# the startup, the runtime, the interrupts, the flash library and the C library's functions,
# then the constants
AT	0x0e000
SEG	@@CSTART
SEG	@@RTCODE
SEG	@@BASE
SEG	@@FSLCOD
SEG	@@LCODE
SEG	@@FSLOPN
# the constants start where Sony's do: the code before them is a few bytes shorter than
# Sony's (handlers that are proven or reviewed, not exact), and the constants' page breaks
# must fall as Sony's do
AT	0x0f6f6		IF ERNIE_BOARD==0x00415000&&ERNIE_FW==0x01000306
AT	0x0f6f6		IF ERNIE_BOARD==0x00411000&&ERNIE_FW==0x01000306&&ERNIE_HW!=0x00102603&&ERNIE_HW!=0x00315200
AT	0x0f74a		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x01000306
AT	0x0f77e		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x01000306
AT	0x0f692		IF ERNIE_BOARD==0x00415000&&ERNIE_FW==0x0100010B
AT	0x0f692		IF ERNIE_BOARD==0x00411000&&ERNIE_FW==0x0100010B&&ERNIE_HW!=0x00102603&&ERNIE_HW!=0x00315200
AT	0x0f6e6		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x0100010B
AT	0x0f71a		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x0100010B
AT	0x0f692		IF ERNIE_BOARD==0x00415000&&ERNIE_FW==0x0100010A
AT	0x0f692		IF ERNIE_BOARD==0x00411000&&ERNIE_FW==0x0100010A&&ERNIE_HW!=0x00102603&&ERNIE_HW!=0x00315200
AT	0x0f6e6		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x0100010A
AT	0x0f71a		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x0100010A
AT	0x0f692		IF ERNIE_BOARD==0x00415000&&ERNIE_FW==0x01000109
AT	0x0f692		IF ERNIE_BOARD==0x00411000&&ERNIE_FW==0x01000109&&ERNIE_HW!=0x00102603&&ERNIE_HW!=0x00315200
AT	0x0f6e6		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x01000109
AT	0x0f71a		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x01000109
AT	0x0f692		IF ERNIE_BOARD==0x00415000&&ERNIE_FW==0x01000107
AT	0x0f692		IF ERNIE_BOARD==0x00411000&&ERNIE_FW==0x01000107&&ERNIE_HW!=0x00102603&&ERNIE_HW!=0x00315200
AT	0x0f6e6		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x01000107
AT	0x0f71a		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x01000107
AT	0x0f67a		IF ERNIE_BOARD==0x00415000&&ERNIE_FW==0x01000104
AT	0x0f67a		IF ERNIE_BOARD==0x00411000&&ERNIE_FW==0x01000104&&ERNIE_HW!=0x00102603&&ERNIE_HW!=0x00315200
AT	0x0f6ce		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x01000104
AT	0x0f702		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x01000104
AT	0x0f6e0		IF ERNIE_BOARD==0x00415000&&ERNIE_FW==0x00090903
AT	0x0f6e0		IF ERNIE_BOARD==0x00411000&&ERNIE_FW==0x00090903&&ERNIE_HW!=0x00102603&&ERNIE_HW!=0x00315200
AT	0x0f6e2		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x00090903
AT	0x0f716		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x00090903
AT	0x0f57a		IF ERNIE_BOARD==0x00415000&&ERNIE_FW==0x00090804
AT	0x0f57a		IF ERNIE_BOARD==0x00411000&&ERNIE_FW==0x00090804&&ERNIE_HW!=0x00102603&&ERNIE_HW!=0x00315200
AT	0x0f57c		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x00090804
AT	0x0f5b0		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x00090804
AT	0x0f4d6		IF ERNIE_BOARD==0x00415000&&ERNIE_FW==0x00090206
AT	0x0f4d6		IF ERNIE_BOARD==0x00411000&&ERNIE_FW==0x00090206&&ERNIE_HW!=0x00102603&&ERNIE_HW!=0x00315200
AT	0x0f546		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x00090206
AT	0x0f57a		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x00090206
AT	0x0f4fa		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x00090009
AT	0x0f592		IF ERNIE_BOARD==0x00406000&&ERNIE_FW==0x01000306
AT	0x0f52c		IF ERNIE_BOARD==0x00406000&&ERNIE_FW==0x0100010B
AT	0x0f488		IF ERNIE_BOARD==0x00406000&&ERNIE_FW==0x0100060B&&ERNIE_HW!=0x00601000
AT	0x0f488		IF ERNIE_BOARD==0x00406000&&ERNIE_FW==0x0100060D
AT	0x0f6f6		IF ERNIE_BOARD==0x00414000&&ERNIE_FW==0x01000306
AT	0x0f692		IF ERNIE_BOARD==0x00414000&&ERNIE_FW==0x0100010B
AT	0x0f692		IF ERNIE_BOARD==0x00414000&&ERNIE_FW==0x0100010A
AT	0x0f692		IF ERNIE_BOARD==0x00414000&&ERNIE_FW==0x01000109
AT	0x0f692		IF ERNIE_BOARD==0x00414000&&ERNIE_FW==0x01000107
AT	0x0f67a		IF ERNIE_BOARD==0x00414000&&ERNIE_FW==0x01000104
AT	0x0f6e0		IF ERNIE_BOARD==0x00414000&&ERNIE_FW==0x00090903
AT	0x0f57a		IF ERNIE_BOARD==0x00414000&&ERNIE_FW==0x00090804
AT	0x0f4d6		IF ERNIE_BOARD==0x00414000&&ERNIE_FW==0x00090206
AT	0x0f6f6		IF ERNIE_BOARD==0x00416000&&ERNIE_FW==0x01000306
AT	0x0f692		IF ERNIE_BOARD==0x00416000&&ERNIE_FW==0x0100010B
AT	0x0f692		IF ERNIE_BOARD==0x00416000&&ERNIE_FW==0x0100010A
AT	0x0f692		IF ERNIE_BOARD==0x00416000&&ERNIE_FW==0x01000109
AT	0x0f692		IF ERNIE_BOARD==0x00416000&&ERNIE_FW==0x01000107
AT	0x0f67a		IF ERNIE_BOARD==0x00416000&&ERNIE_FW==0x01000104
AT	0x0f5ee		IF ERNIE_BOARD==0x00416000&&ERNIE_FW==0x0100060B
AT	0x0f5ba		IF ERNIE_HW==0x00601000&&ERNIE_FW==0x0100060B
AT	0x0f5ee		IF ERNIE_BOARD==0x00416000&&ERNIE_FW==0x0100060D
SEG	@@R_INIT
SEG	@@R_INIS
SEG	@@CNSTL|@@FSLCNS
# the initialised data's values
SEG	@@RLINIT	cstart.asm
SEG	@@RLINIT
# the code, to 0x353ff (the updater's from 0x35400)
SEG	@@CODEL		IF ERNIE_FW!=0x01000306
SEG	@@CODEL		main.c tau.c standby.c task1.c task2.c version.c rtc.c task3.c input.c aes.c
SEG	@@CODEL		host.c request.c csi.c sleepfactor.c spidev.c command.c uart.c clockout.c csi10.c dma.c
SEG	@@CODEL		touch.c inputreq.c
SEG	@@CODEL		csi01.c motion.c IF ERNIE_FW<0x0100060B
SEG	@@CODEL		util.c inputbits.c serial.c adc.c analog.c scratchpad.c
SEG	@@CODEL		nvsreq.c serial1.c updatereq.c sha1.c powerreq.c task5.c serialauth.c nvs.c power.c timer.c
SEG	@@CODEL		iica.c powerjob.c elmo.c serial2.c
SEG	@@CODEL		uart4.c IF ERNIE_BOARD!=0x00406000||ERNIE_HW==0x00601000
SEG	@@CODEL		interrupt.c serial4.c task6.c bbmc.c trace.c board.c powerseq.c battery.c charge.c cookie.c powerwait.c state.c
# The original initialization leaves a return-address byte on the stack that the
# host handshake passes to rel_mpf when its first allocation fails. Preserve it.
AT	0x2b48d		IF ERNIE_BOARD==0x00415000||ERNIE_BOARD==0x00411000&&ERNIE_FW!=0x01000306&&ERNIE_HW!=0x00102603
AT	0x2a901		IF ERNIE_HW==0x00315200&&ERNIE_FW==0x01000306
AT	0x2b628		IF ERNIE_HW==0x00411000&&ERNIE_FW==0x01000306
AT	0x2b739		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x01000306
AT	0x2b57c		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x0100010B
AT	0x2b4c2		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x0100010A
AT	0x2b48c		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x01000109
AT	0x2b119		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x01000107
AT	0x2af03		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x01000104
AT	0x2b07b		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x00090903
AT	0x29c41		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x00090804
AT	0x27a0a		IF ERNIE_HW==0x00102603&&ERNIE_FW==0x00090206
AT	0x29ced		IF ERNIE_BOARD==0x00406000
AT	0x2b3b6		IF ERNIE_BOARD==0x00416000&&ERNIE_FW==0x01000306
SEG	@@CODEL		handshake.c
SEG	@@CODEL		serial1op.c param.c
SEG	@@CODEL

# the RAM: kept over a warm start, then the heap, the near data, the flash library's
AT	0xfd900
SEG	@@DATAL		main.c param.c watchdog.c
SEG	@@HEAP
SEG	@@INIT
SEG	@@DATA		cstart.asm input.c util.c adc.c analog.c serialauth.c power.c timer.c sysinfo.c
SEG	@@DATA		handshake.c cstartend.asm IF ERNIE_FW!=0x01000306
SEG	@@FSLDAT	IF ERNIE_FW!=0x01000306
SEG	@@INIS		IF ERNIE_FW!=0x01000306
# The original handshake packet and state start here on these boards.
AT	0xfdcde		IF ERNIE_BOARD==0x00415000&&ERNIE_FW>=0x01000306
AT	0xfdcde		IF ERNIE_BOARD==0x00411000&&ERNIE_FW>=0x01000306
AT	0xfdcd4		IF ERNIE_BOARD==0x00415000&&ERNIE_FW<0x01000306&&ERNIE_FW>=0x00090903
AT	0xfdcd4		IF ERNIE_BOARD==0x00411000&&ERNIE_FW<0x01000306&&ERNIE_FW>=0x00090903
AT	0xfdcd0		IF ERNIE_BOARD==0x00415000&&ERNIE_FW<=0x00090804
AT	0xfdcd0		IF ERNIE_BOARD==0x00411000&&ERNIE_FW<=0x00090804
AT	0xfdcde		IF ERNIE_BOARD==0x00406000
AT	0xfdcde		IF ERNIE_BOARD==0x00416000
SEG	@@DATA		handshake.c cstartend.asm
SEG	@@FSLDAT
# the startup's (empty) saddr initialised data, where Sony's link has it
SEG	@@INIS
# the kernel's own RAM (kernel.asm's @@KRAM): its state, its tables, the fixed-size pools'
# blocks
AT	0xfdd46		IF ERNIE_FW>=0x01000306&&ERNIE_KERNEL!=0x00411000&&ERNIE_HW!=0x00315200
AT	0xfdd4a		IF ERNIE_FW>=0x01000306&&ERNIE_HW==0x00315200
AT	0xfdd4c		IF ERNIE_FW>=0x01000306&&ERNIE_KERNEL==0x00411000
AT	0xfdd3c		IF ERNIE_FW<0x01000306&&ERNIE_FW>=0x01000107&&ERNIE_KERNEL!=0x00411000&&ERNIE_HW!=0x00315200
AT	0xfdd40		IF ERNIE_FW<0x01000306&&ERNIE_FW>=0x01000107&&ERNIE_HW==0x00315200
AT	0xfdd42		IF ERNIE_FW<0x01000306&&ERNIE_FW>=0x01000107&&ERNIE_KERNEL==0x00411000
AT	0xfdd0e		IF ERNIE_FW<0x01000107&&ERNIE_FW>=0x00090903&&ERNIE_KERNEL!=0x00411000&&ERNIE_HW!=0x00315200
AT	0xfdd12		IF ERNIE_FW<0x01000107&&ERNIE_FW>=0x00090903&&ERNIE_HW==0x00315200
AT	0xfdd14		IF ERNIE_FW<0x01000107&&ERNIE_FW>=0x00090903&&ERNIE_KERNEL==0x00411000
AT	0xfdcf4		IF ERNIE_FW<=0x00090804&&ERNIE_KERNEL!=0x00411000&&ERNIE_HW!=0x00315200
AT	0xfdcf8		IF ERNIE_FW<=0x00090804&&ERNIE_HW==0x00315200
AT	0xfdcfa		IF ERNIE_FW<=0x00090804&&ERNIE_KERNEL==0x00411000
SEG	@@KRAM
# after the kernel's: the flash library's buffer, the initialised data, then what cstart
# clears, from its start label to cstartend's
AT	0xfe06c		IF ERNIE_FW>=0x01000306&&ERNIE_KERNEL!=0x00411000&&ERNIE_HW!=0x00315200
AT	0xfe070		IF ERNIE_FW>=0x01000306&&ERNIE_HW==0x00315200
AT	0xfe072		IF ERNIE_FW>=0x01000306&&ERNIE_KERNEL==0x00411000
AT	0xfe062		IF ERNIE_FW<0x01000306&&ERNIE_FW>=0x01000107&&ERNIE_KERNEL!=0x00411000&&ERNIE_HW!=0x00315200
AT	0xfe066		IF ERNIE_FW<0x01000306&&ERNIE_FW>=0x01000107&&ERNIE_HW==0x00315200
AT	0xfe068		IF ERNIE_FW<0x01000306&&ERNIE_FW>=0x01000107&&ERNIE_KERNEL==0x00411000
AT	0xfe034		IF ERNIE_FW<0x01000107&&ERNIE_FW>=0x00090903&&ERNIE_KERNEL!=0x00411000&&ERNIE_HW!=0x00315200
AT	0xfe038		IF ERNIE_FW<0x01000107&&ERNIE_FW>=0x00090903&&ERNIE_HW==0x00315200
AT	0xfe03a		IF ERNIE_FW<0x01000107&&ERNIE_FW>=0x00090903&&ERNIE_KERNEL==0x00411000
AT	0xfe01a		IF ERNIE_FW<=0x00090804&&ERNIE_KERNEL!=0x00411000&&ERNIE_HW!=0x00315200
AT	0xfe01e		IF ERNIE_FW<=0x00090804&&ERNIE_HW==0x00315200
AT	0xfe020		IF ERNIE_FW<=0x00090804&&ERNIE_KERNEL==0x00411000
SEG	@@DATA		main.c
SEG	@@INITL
SEG	@@DATAL		cstart.asm
SEG	@@DATAL
# the short direct area
AT	0xffe20
SEG	@@DATS		cstart.asm
SEG	@@DATS
# the saddr bits (0x00090804's updater flag), after the kernel's saddr work area
AT	0xffe78		IF ERNIE_FW<=0x00090804
SEG	@@BITS
AT	0xffee2
SEG	@@FSLSAD
