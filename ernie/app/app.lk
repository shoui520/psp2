SEG	@@KCLRF	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KRMBX	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KRMPF	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KRCYC	ALIGN 2 IF ERNIE_HW==0x00723030
