# The application's link (tools/lk78k0r.py): its objects in link order, then where their
# segments go, as Sony's image has them. Boot cluster 0 (0x0000-0x0fff: the vectors, the
# configuration's defaults at 0x800, the version block at 0xf00), the kernel from 0xc000, the
# rest from 0xe000 to 0x353ff; the RAM the updater keeps (0xfd900) first.

OBJECT	main.c
OBJECT	tau.c
OBJECT	standby.c
OBJECT	task1.c
OBJECT	task2.c
OBJECT	version.c
OBJECT	rtc.c
OBJECT	task3.c
OBJECT	input.c
OBJECT	aes.c
OBJECT	host.c
OBJECT	request.c
OBJECT	csi.c
OBJECT	sleepfactor.c
OBJECT	spidev.c
OBJECT	command.c
OBJECT	uart.c
OBJECT	clockout.c	IF ERNIE_HW<0x00700000	# DOL-1001: in main.c
OBJECT	csi10.c
OBJECT	dma.c		IF ERNIE_HW!=0x00805038	# the slim has the DTC (dtc.c)
OBJECT	touch.c
OBJECT	inputreq.c
OBJECT	csi01.c		IF ERNIE_FW<0x0100060B	# BOARD_MOTION
OBJECT	motion.c	IF ERNIE_FW<0x0100060B
OBJECT	util.c
OBJECT	inputbits.c
OBJECT	serial.c
OBJECT	adc.c
OBJECT	analog.c
OBJECT	scratchpad.c
OBJECT	nvsreq.c
OBJECT	serial1.c
OBJECT	updatereq.c
OBJECT	sha1.c
OBJECT	powerreq.c
OBJECT	task5.c
# the serial authentication's keys: their own object, before serialauth.c's tables (since
# 0x0100060B all the keys, after led.c)
OBJECT	authkeys.c	IF ERNIE_FW<0x0100060B
OBJECT	serialauth.c
OBJECT	nvs.c
OBJECT	power.c
# the flash library's settings come here in Sony's link: in the constants' page, after
# power.c's and before uart4.c's (fslConfig fills the page's end before uart4Bauds)
OBJECT	../lib/fsl.asm
OBJECT	timer.c
OBJECT	iica.c
OBJECT	powerjob.c
OBJECT	elmo.c
OBJECT	serial2.c
OBJECT	uart4.c		IF ERNIE_BOARD!=0x00406000||ERNIE_HW==0x00601000	# BOARD_SERIAL4
OBJECT	interrupt.c
OBJECT	uart4.c		IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000	# BOARD_DOL1001: its interrupts after interrupt.c's
OBJECT	multicn.c	IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000	# BOARD_DOL1001: the slim's outputs on the fat board's switch
OBJECT	powerled.c	IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000	# BOARD_DOL1001: the slim's power LED flags
OBJECT	flash.c		IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000	# BOARD_DOL1001: configFlashWrite and updaterFlashPrepare
OBJECT	thermal.c	IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000	# BOARD_DOL1001: the temperature sensor
OBJECT	serial4.c
OBJECT	task6.c
OBJECT	bbmc.c
OBJECT	trace.c		IF ERNIE_HW<0x00700000||ERNIE_HW>=0x00800000	# DOL-1001 has none
OBJECT	board.c
OBJECT	powerseq.c
OBJECT	battery.c
OBJECT	charge.c
OBJECT	cookie.c
OBJECT	powerwait.c
OBJECT	state.c
OBJECT	handshake.c
OBJECT	serial1op.c
OBJECT	task.c		IF ERNIE_FW>=0x00080502	# 0x00080307 has none
# before 0x01000104 the configuration's defaults are among the constants, before config.c's
OBJECT	configdefault.c	IF ERNIE_FW<0x01000104&&ERNIE_FW>=0x00090502	# 0x00090206 has no defaults
OBJECT	config.c	IF ERNIE_FW>=0x00080502	# 0x00080307 has no settings
OBJECT	configreq.c	IF ERNIE_FW>=0x00080502
OBJECT	watchdog.c	IF ERNIE_FW>=0x00090006
OBJECT	sysinfo.c
OBJECT	log.c		IF ERNIE_FW>=0x00090502
# param.c's constants follow log.c's in Sony's link (its code is placed before config.c's)
OBJECT	param.c
# 0x00090206 has no power LED fade: its LED is powerseq.c's powerLedSet
OBJECT	led.c		IF ERNIE_FW>=0x00090502&&ERNIE_HW<0x00700000||ERNIE_FW>=0x00090502&&ERNIE_HW>=0x00800000	# DOL-1001 has none: its LED is powerled.c's
OBJECT	authkeys.c	IF ERNIE_FW>=0x0100060B
OBJECT	serialreq.c	IF ERNIE_FW>=0x00090903
OBJECT	snvs.c		IF ERNIE_FW>=0x00090903
OBJECT	debugpin.c	IF ERNIE_FW>=0x0100060B
OBJECT	gf.c		IF ERNIE_FW<0x0100060B
OBJECT	aestable.c	IF ERNIE_FW>=0x0100060B
OBJECT	configdefault.c	IF ERNIE_FW>=0x01000104
OBJECT	kernel.asm
OBJECT	kernelcfg.asm
OBJECT	cstart.asm
OBJECT	vectors.asm
# the CA78K0R libraries' modules it uses
OBJECT	../lib/lucom.asm
OBJECT	../lib/iumul.asm
OBJECT	../lib/lumul.asm
OBJECT	../lib/cudiv.asm
OBJECT	../lib/iudiv.asm	IF ERNIE_FW>=0x00090903
OBJECT	../lib/lsdiv.asm	IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000	# BOARD_DOL1001: thermal.c's
OBJECT	../lib/ludiv.asm	IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000
OBJECT	../lib/curem.asm
OBJECT	../lib/luadd.asm
OBJECT	../lib/lulsh.asm
OBJECT	../lib/lursh.asm
OBJECT	../lib/cscmp.asm	IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000	# BOARD_DOL1001: thermal.c's
OBJECT	../lib/iscmp.asm	IF ERNIE_FW<0x01040000	# bbmcTrace's, an int loop before 0x0104
OBJECT	../lib/lscmp.asm	IF ERNIE_FW<0x01000306
OBJECT	../lib/luband.asm
OBJECT	../lib/lubor.asm
OBJECT	../lib/lubxor.asm
OBJECT	../lib/divuw.asm
OBJECT	../lib/fslinfo.asm
OBJECT	../lib/fslwrite.asm
OBJECT	../lib/fslsecurity.asm
OBJECT	../lib/fslflags.asm
OBJECT	../lib/fslswap.asm
OBJECT	../lib/memcpy.asm
OBJECT	../lib/memcpy_n.asm	IF ERNIE_FW>=0x01000107
OBJECT	../lib/memmove.asm	IF ERNIE_FW>=0x00090502	# log.c's
OBJECT	../lib/memcmp.asm
OBJECT	../lib/memset.asm
OBJECT	../lib/memset_n.asm
OBJECT	../lib/vsprintf.asm	IF ERNIE_FW<0x00080307	# 0x00080003's and 0x00080302's tracePrintf
OBJECT	../lib/fslopen.asm
# the ends of the startup's segments, after everything
OBJECT	cstartend.asm

# the compiler's runtime registers
SYMBOL	_@SEGAX		0xffed4
SYMBOL	_@SEGBC		0xffed5
SYMBOL	_@SEGDE		0xffed6
SYMBOL	_@SEGHL		0xffed7
SYMBOL	_@RTARG0	0xffed8
SYMBOL	_@RTARG1	0xffed9
SYMBOL	_@RTARG2	0xffeda
SYMBOL	_@RTARG3	0xffedb
SYMBOL	_@RTARG4	0xffedc
SYMBOL	_@RTARG5	0xffedd
SYMBOL	_@RTARG6	0xffede
SYMBOL	_@RTARG7	0xffedf
# and as the libraries' and the kernel's modules name them
SYMBOL	@SEGAX		0xffed4
SYMBOL	@SEGBC		0xffed5
SYMBOL	@SEGDE		0xffed6
SYMBOL	@SEGHL		0xffed7
SYMBOL	@RTARG0		0xffed8
SYMBOL	@RTARG2		0xffeda
SYMBOL	@RTARG4		0xffedc
SYMBOL	@RTARG6		0xffede
RESERVE	0xffed4		12
# the settings' two banks in the flash, which neither program's image holds
SYMBOL	_configBanks	0x3b800		IF ERNIE_HW!=0x00805038
SYMBOL	_configBanks	0x5f800		IF ERNIE_HW==0x00805038	# the slim's, at the end of its 384 KiB

# the interrupts' vectors are vectors.asm's table, not the compiler's
DROP	@@VECT??

# boot cluster 0: the vectors, the CALLT table and the option bytes, the configuration's
# defaults ("ConfZZ"), the version block
AT	0x00000
SEG	@@VECT
AT	0x00200	IF ERNIE_FW>=0x0100060B	# aes.c's round tables
SEG	@@CNSTL		aestable.c IF ERNIE_FW>=0x0100060B
AT	0x00800	IF ERNIE_FW>=0x01000104
SEG	@@CNSTL		configdefault.c IF ERNIE_FW>=0x01000104
AT	0x00f00
SEG	@@CNSTL		version.c

# the kernel and its configuration
AT	0x0c000
# kernel.asm's modules, in its order
SEG	@@KACT|@@KCHG|@@KCLRF|@@KDISD|@@KDLY|@@KENAD|@@KEXT|@@KGETM|@@KICYC|@@KIFLG|@@KIMBX|@@KIMPF|@@KINT|@@KRDYD|@@KMKRDY|@@KQINS|@@KTMINS|@@KWAIT|@@KRCV|@@KRCYC|@@KRFLG|@@KRMBX|@@KRMPF|@@KRTSK|@@KRVER|@@KREL|@@KRETI|@@KSTART|@@KHOOK|@@KDISP|@@KSETF|@@KSND|@@KSTAC|@@KSVCE|@@KSVCX|@@KTACT|@@KTSTA|@@KTINI|@@KTICK|@@KTRSE|@@KTRSX|@@KTRIE|@@KTRIX|@@KTRTS|@@KTRD|@@KWREL|@@KWTAB|@@KWFLG|@@KWMBX|@@KWMPF|@@KRDYR|@@KQREM|@@KWSEM|@@KTMREM|@@KWAIF	IF ERNIE_HW<0x00700000&&ERNIE_FW<0x00080302||ERNIE_HW<0x00700000&&ERNIE_FW>=0x00080307||ERNIE_HW<0x00700000&&ERNIE_HW!=0x00102003||ERNIE_HW>=0x00800000
# 0x00080302: each of the kernel's modules at an even address, the gaps 0x00 (NOP)
FILL	0x00		IF ERNIE_FW>=0x00080302&&ERNIE_FW<0x00080307&&ERNIE_HW==0x00102003
SEG	@@KACT|@@KCHG|@@KCLRF|@@KDISD|@@KDLY|@@KENAD|@@KEXT|@@KGETM|@@KICYC|@@KIFLG|@@KIMBX|@@KIMPF|@@KINT|@@KRDYD|@@KMKRDY|@@KQINS|@@KTMINS|@@KWAIT|@@KRCV|@@KRCYC|@@KRFLG|@@KRMBX|@@KRMPF|@@KRTSK|@@KRVER|@@KREL|@@KRETI|@@KSTART|@@KHOOK|@@KDISP|@@KSETF|@@KSND|@@KSTAC|@@KSVCE|@@KSVCX|@@KTACT|@@KTSTA|@@KTINI|@@KTICK|@@KTRSE|@@KTRSX|@@KTRIE|@@KTRIX|@@KTRTS|@@KTRD|@@KWREL|@@KWTAB|@@KWFLG|@@KWMBX|@@KWMPF|@@KRDYR|@@KQREM|@@KWSEM|@@KTMREM|@@KWAIF ALIGN 2	IF ERNIE_FW>=0x00080302&&ERNIE_FW<0x00080307&&ERNIE_HW==0x00102003
FILL	none		IF ERNIE_FW>=0x00080302&&ERNIE_FW<0x00080307&&ERNIE_HW==0x00102003
# DOL-1001: each of the kernel's modules at an even address, the gaps 0x00
FILL	0x00		IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000
SEG	@@KACT|@@KCHG|@@KCLRF|@@KDISD|@@KDLY|@@KENAD|@@KEXT|@@KGETM|@@KICYC|@@KIFLG|@@KIMBX|@@KIMPF|@@KINT|@@KRDYD|@@KMKRDY|@@KQINS|@@KTMINS|@@KWAIT|@@KRCV|@@KRCYC|@@KRFLG|@@KRMBX|@@KRMPF|@@KRTSK|@@KRVER|@@KREL|@@KRETI|@@KSTART|@@KHOOK|@@KDISP|@@KSETF|@@KSND|@@KSTAC|@@KSVCE|@@KSVCX|@@KTACT|@@KTSTA|@@KTINI|@@KTICK|@@KTRSE|@@KTRSX|@@KTRIE|@@KTRIX|@@KTRTS|@@KTRD|@@KWREL|@@KWTAB|@@KWFLG|@@KWMBX|@@KWMPF|@@KRDYR|@@KQREM|@@KWSEM|@@KTMREM|@@KWAIF ALIGN 2	IF ERNIE_HW>=0x00700000&&ERNIE_HW<0x00800000&&ERNIE_HW!=0x00723030
# DOL-1002: in the slim's order (uss1001.lk)
SEG	@@KSND	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KSTAC	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KRETI	ALIGN 2 IF ERNIE_HW==0x00723030
SEG	@@KSETF	ALIGN 2 IF ERNIE_HW==0x00723030
