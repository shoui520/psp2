+/*
+ * PlayStation(R)Vita: the bitmap block lists behind DTrace's ID arenas
+ * (dtrace/sce/solaris_vmem.c). Memory comes from DTrace's own heap, and
+ * panic() is the kernel's.
+ *
+ * Sony's debug records give the panics' lines in its file: 486, 531, 604
+ * and 628. What Sony wrote in this block is not known beyond what the
+ * code needs; it is as long as Sony's, and the note in blst_leaf_free
+ * stands for the five lines Sony's file has there, so the records come
+ * out the same.
+ */
+/*
+ * the kernel build, as xnu's: no blist_print, no BLIST_DEBUG test program
+ */
+#ifndef _KERNEL
+#define _KERNEL
+#endif
+
+#include <dtrace/sce/solaris_types.h>
+#include <dtrace/heap.h>
+#include <sysmem/debug.h>
+#include <dtrace/bsd/blist.h>
+
+#define malloc(a, b, c)	dtrace_heap_alloc(a)
+#define free(a, b)	dtrace_heap_free(a)
+
+#elif !defined(__APPLE__)
 #ifdef _KERNEL
 
