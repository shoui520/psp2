+int sslCheckRsaKeyLimits(s,pkey)
+SSL *s;
+void *pkey;
+	{
+	struct
+		{
+		int length;
+		unsigned char *data;
+		} modulus,exponent;
+	unsigned int mod_bits,exp_bits;
+	int i,j;
+
+	if ((s == NULL) || (pkey == NULL))
+		return(0);
+	mod_bits=s->max_rsa_modulus_bits;
+	exp_bits=s->max_rsa_exponent_bits;
+	modulus.length=0;
+	modulus.data=NULL;
+	exponent.length=0;
+	exponent.data=NULL;
+	if (sslGetPublicKeyInfo(pkey,0x10,&modulus) != 0)
+		return(0);
+	if (sslGetPublicKeyInfo(pkey,0x11,&exponent) != 0)
+		return(0);
+	for (i=0; i < modulus.length; i++)
+		{
+		if (modulus.data[i] != 0)
+			{
+			mod_bits=(unsigned int)((modulus.length - i) * 8);
+			for (j=7; j >= 0; j--)
+				{
+				if (modulus.data[i] & (1 << j))
+					break;
+				mod_bits--;
+				}
+			break;
+			}
+		}
+	for (i=0; i < exponent.length; i++)
+		{
+		if (exponent.data[i] != 0)
+			{
+			exp_bits=(unsigned int)((exponent.length - i) * 8);
+			for (j=7; j >= 0; j--)
+				{
+				if (exponent.data[i] & (1 << j))
+					break;
+				exp_bits--;
+				}
+			break;
+			}
+		}
+	if ((mod_bits > s->max_rsa_modulus_bits) ||
+		(exp_bits > s->max_rsa_exponent_bits))
+		return(0);
+	return(1);
+	}
