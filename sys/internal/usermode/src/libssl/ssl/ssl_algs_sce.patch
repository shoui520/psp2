+	return(ssl_temp_rsa_1024);
+	}
+
+void sslSetTempRsaKey512(void *key)
+	{
+	if (ssl_temp_rsa_512 != NULL)
+		SceSslInternal_46358909(ssl_temp_rsa_512);
+	ssl_temp_rsa_512 = key;
+	}
+
+void sslSetTempRsaKey1024(void *key)
+	{
+	if (ssl_temp_rsa_1024 != NULL)
+		SceSslInternal_46358909(ssl_temp_rsa_1024);
+	ssl_temp_rsa_1024 = key;
+	}
+
+void sslFreeTempRsaKeys(void)
