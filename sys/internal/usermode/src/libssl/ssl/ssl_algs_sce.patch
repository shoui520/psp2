+int sslGenerateTempRsaKey(void *crypto_ctx, int bits, int exp_type,
+	void *key_ctx, void **out_key)
+	{
+	int status;
+	SslCryptoAlgorithm *alg = NULL;
+
+	if ((crypto_ctx == NULL) || (out_key == NULL))
+		{
+		status = 0x2721;
+		goto err;
+		}
+	*out_key = NULL;
+	status = sslCreatePublicKey(key_ctx, 6, out_key);
+	if (status != 0)
+		goto err;
+	status = sslCreateAlgorithm(crypto_ctx, 8, 0x1003, 0, &alg);
+	if (status == 0)
+		{
+		status = sslKeyGenInit(alg);
+		if (status == 0)
+			{
+			status = sslSetAlgorithmInfo(alg, 22, (SceUIntPtr)&bits);
+			if (status == 0)
+				{
+				status = sslSetAlgorithmInfo(alg, 23, (SceUIntPtr)&exp_type);
+				if (status == 0)
+					status = sslGenerateKey(alg, out_key);
+				}
+			}
+		}
+	if (status != 0)
+		{
+err:
+		if ((out_key != NULL) && (*out_key != NULL))
+			{
+			SceSslInternal_46358909(*out_key);
+			*out_key = NULL;
+			}
+		}
+	if (alg != NULL)
+		sslDestroyAlgorithm(alg);
+	return(status);
+	}
+
+int sslCtxSetupTempRsaKeys(SSL_CTX *ctx, int mode, int use_callback)
+	{
+	int ret = 0;
+	void *key;
+	unsigned long f4;
+
+	if (use_callback == 0)
+		{
+		f4 = ctx->options & 0x10000;
+		if (mode & 1)
+			{
+			if (sslGenerateTempRsaKey(ctx->crypto_context, 512, 2,
+				ctx->key_context, &key) != 0)
+				return(0);
+			SSL_CTX_ctrl(ctx, 62, 0, (char *)key);
+			ret = 1;
+			SceSslInternal_46358909(key);
+			}
+		if (mode & 0x10)
+			{
+			if (sslGenerateTempRsaKey(ctx->crypto_context, 1024,
+				(f4 != 0) ? 3 : 2, ctx->key_context, &key) == 0)
+				{
+				SSL_CTX_ctrl(ctx, 63, 0, (char *)key);
+				ret = 1;
+				SceSslInternal_46358909(key);
+				}
+			}
+		}
+	else if (mode & 0x11)
+		{
+		SSL_CTX_ctrl(ctx, 59, 0, (char *)sslGetOrCreateTempRsaKeyCallback);
+		ret = 1;
+		}
+	return(ret);
+	}
+
+void *sslGetOrCreateTempRsaKeyCallback(SSL *s, int is_export)
+	{
+	void *key = NULL;
+	int f4 = (s->ctx->options & 0x10000) ? 1 : 0;
+	int bits = 0, exp_type = 0;
+
+	if (is_export == 1)
+		{
+		key = sslGetTempRsaKey512();
+		if (key == NULL)
+			{
+			bits = 512;
+			exp_type = 2;
+			}
+		}
+	else
+		{
+		key = sslGetTempRsaKey1024();
+		if (key == NULL)
+			{
+			bits = 1024;
+			exp_type = f4 ? 3 : 2;
+			}
+		}
+	if (exp_type != 0)
+		{
+		if (sslGenerateTempRsaKey(s->ctx->crypto_context, bits, exp_type,
+			s->ctx->key_context, &key) == 0)
+			{
+			if (bits == 512)
+				sslSetTempRsaKey512(key);
+			else
+				sslSetTempRsaKey1024(key);
+			}
+		}
+	return(key);
 	}
 
+void sslResetTempRsaKeys(void)
+	{
+	ssl_temp_rsa_512 = NULL;
+	ssl_temp_rsa_1024 = NULL;
+	}
+
+void *sslGetTempRsaKey512(void)
+	{
+	return(ssl_temp_rsa_512);
+	}
+
+void *sslGetTempRsaKey1024(void)
