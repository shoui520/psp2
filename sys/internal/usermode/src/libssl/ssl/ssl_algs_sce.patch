+int SSL_library_init(void)
+	{
+	sslResetWeakCipherFlags();
+	sslRetainExDataMethods();
+	return(1);
+	}
+
+int sslLibraryCleanup(void)
+	{
+	sslFreeTempRsaKeys();
+	sslReleaseExDataMethods();
+	sslResetWeakCipherFlags();
+	sslRemoveThreadErrors(0);
+	return(1);
+	}
