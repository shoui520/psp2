+/* SCE: SSL-C subject-name extraction adaptation of add_client_CA;
+ * descriptive helper name is ours.
+ */
+int sslAddClientCa(STACK **sk, void *x)
+	{
+	void *name=NULL;
+	int err=0;
+
+	if ((*sk == NULL) && ((*sk=sk_new_null()) == NULL))
+		{
+		err=10005;
+		goto err;
+		}
+	err=SceSslInternal_08179EBD(x,0,&name);
+	if (err != 0)
+		goto err;
+	if (sk_push(*sk,(char *)name) <= 0)
+		{
+		err=10005;
+		goto err;
+		}
+	return(0);
+err:
+	if (name != NULL)
+		SceSslInternal_CE37B69E(name);
+	return(err);
+	}
+
+int SceSslInternal_00ABEBC3(SSL_CTX *ctx, void *x)
+	{
