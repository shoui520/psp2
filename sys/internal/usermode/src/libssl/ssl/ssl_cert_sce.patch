+		status=sslGetVerifyChainEntryError(entry,&error);
+		if (status == 0)
+			{
+			saved_error=error;
+			status=ssl->verify_callback(ssl,cert,depth,&error);
+			if (status == 0)
+				{
+				if (error != saved_error)
+					{
+					if (error != 0)
+						error=10;
+					sslSetVerifyChainEntryError(entry,error);
+					}
+				status=0;
+				}
+			}
+		}
+	return(status);
+	}
