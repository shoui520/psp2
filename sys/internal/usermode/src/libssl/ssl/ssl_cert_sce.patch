+		{
+		SSLerr(234,ERR_R_MALLOC_FAILURE);
+		goto end;
+		}
+	if (sslResetCertificateStoreCursor(cursor) != 0)
+		goto end;
+	if (sslSetCertificateStoreCursorCertificate(cursor,cert,NULL) != 0)
+		goto end;
+	ret=sslSetCertificateStoreCursorFlags(cursor,flags);
+	if (ret == 0)
+		{
+		sslOpenCertificateStore(ctx->cert_store,8);
+		status=sslAddCertificateStoreEntry(cursor);
+		sslCloseCertificateStore(ctx->cert_store,8);
+		if (status == 0)
+			{
+			sslRetainCertificateObject(cert);
+			ret=1;
+			}
+		}
+end:
+	if (cursor != NULL)
+		sslDestroyCertificateStoreCursor(cursor);
+	return(ret);
+	}
