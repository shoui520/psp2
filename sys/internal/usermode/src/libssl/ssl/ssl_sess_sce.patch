+static int SSL_set_ssl_method(SSL *s, SSL_METHOD *meth)
+	{
+	int ret=1;
+
+	if (s->method != meth)
+		{
+		if (s->method->version == meth->version)
+			s->method=meth;
+		else
+			{
+			s->method->ssl_free(s);
+			s->method=meth;
+			ret=s->method->ssl_new(s);
+			}
+		}
+	s->method->ssl_clear(s);
+	return(ret);
+	}
