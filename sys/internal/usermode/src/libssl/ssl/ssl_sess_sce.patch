+int sslSessionSetExtensions(SSL_SESSION *session, SslExtensionList *extensions)
+	{
+	SslExtensionList *existing;
+
+	if (session == NULL || extensions == NULL)
+		return(10017);
+	existing=session->extensions;
+	if (existing != NULL)
+		{
+		sk_pop_free(existing->entries,(void (*)())sslExtensionFree);
+		Free(existing);
+		}
+	return(sslExtensionListCopy(extensions,&session->extensions));
+	}
+
+int sslSessionGetExtensions(SSL_SESSION *session, SslExtensionList **result)
+	{
+	int status=0;
+
+	if (session == NULL || result == NULL)
+		status=10017;
+	else
+		*result=session->extensions;
+	return(status);
+	}
