+struct SslTime *sslSessionCopyTime(SSL_SESSION *session, struct SslTime *result)
+	{
+	struct SslTime *source;
+	SceUInt32 size;
+
+	if (session == NULL || result == NULL)
+		return(NULL);
+	source=session->time;
+	size=sslGetTimeSize();
+	sslCopyMemory(result,source,size);
+	return(result);
+	}
+
+long SSL_CTX_set_timeout(SSL_CTX *s, long t)
+	{
+	long l=0;
+
+	if (s != NULL)
+		{
+		l=s->session_timeout;
+		if (t > 0)
+			{
+			if ((unsigned long long)t > 0xffffffffULL)
+				t=0x7fffffffL;
+			}
+		else
+			t=s->method->get_timeout();
+		s->session_timeout=t;
+		}
+	return(l);
+	}
