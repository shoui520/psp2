+void ssl_update_cache(SSL *s, int mode)
+	{
+	int i;
+
+	if (s->session->session_id_length == 0) return;
+
+	i=s->ctx->session_cache_mode & SSL_SESS_CACHE_BOTH;
+	if ((i & mode) && (!s->hit) && (s->ctx->session_cache_callback != NULL))
+		{
