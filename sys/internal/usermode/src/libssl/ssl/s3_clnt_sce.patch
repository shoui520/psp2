+static int ssl3_do_write(SSL *s, int type)
+	{
+	int ret;
+
+	ret=ssl3_write_bytes(s,type,&s->init_buf->data[s->init_off],
+		s->init_num);
+	if (ret == s->init_num)
+		return(1);
+	if (ret < 0)
+		return(-1);
+	s->init_off+=ret;
+	s->init_num-=ret;
+	return(0);
+	}
+
+static int ssl3_send_alert(SSL *s, int level, int desc)
+	{
+	desc=s->method->ssl3_enc->alert_value(desc);
+	if (desc < 0)
+		return(1);
+	if ((level == SSL3_AL_FATAL) && (s->session != NULL))
+		{
+		if (s->server)
+			sslRemoveSessionFromCache(s,SSL_SESS_CACHE_SERVER);
+		else
+			sslRemoveSessionFromCache(s,SSL_SESS_CACHE_CLIENT);
+		}
+	s->s3->alert_dispatch=1;
+	s->s3->send_alert[0]=level;
+	s->s3->send_alert[1]=desc;
+	if (s->s3->wbuf.left == 0)
+		return(ssl3_dispatch_alert(s));
+	return(-1);
+	}
