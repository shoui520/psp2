+/* SCE: SSL-C dynamic write-buffer resize helper; descriptive name is ours. */
+int ssl3ResizeWriteBuffer(SSL *s, int len)
+	{
+	unsigned char *p;
+	int capacity;
+
+	if (s->s3->wbuf.buf == NULL)
+		{
+		capacity=len+SCE_SSL3_WRITE_OVERHEAD;
+		if ((int)s->s3->wbuf.capacity >= capacity)
+			return(1);
+		if ((p=(unsigned char *)Realloc(s->s3->wbuf.buf,capacity,
+			s->s3->wbuf.capacity)) == NULL)
+			goto err;
+		memset(&(p[s->s3->wbuf.capacity]),0,capacity-s->s3->wbuf.capacity);
+		s->s3->wbuf.capacity=capacity;
+		s->s3->wbuf.buf=p;
+		s->max_send_fragment=len;
+		}
+	return(1);
+err:
+	SSLerr(SSL_F_SSL3_SETUP_BUFFERS,ERR_R_MALLOC_FAILURE);
+	return(0);
+	}
