+int HeapBinFind(mstate m, mchunkptr chunk) {
+  size_t size = chunksize(chunk);
+  if (is_small(size)) {
+    bindex_t index = small_index(size);
+    sbinptr bin = smallbin_at(m, index);
+    if (smallmap_is_marked(m, index)) {
+      mchunkptr node = bin;
+      do {
+        if (node == chunk)
+          return 1;
+      } while ((node = node->fd) != bin);
+    }
+  }
+  else {
+    bindex_t index;
+    compute_tree_index(size, index);
+    if (treemap_is_marked(m, index)) {
+      tchunkptr tree = *treebin_at(m, index);
+      size_t bits = size << leftshift_for_tree_index(index);
+      while (tree != 0 && chunksize(tree) != size) {
+        tree = tree->child[(bits >> (SIZE_T_BITSIZE - SIZE_T_ONE)) & 1];
+        bits <<= 1;
+      }
+      if (tree != 0) {
+        tchunkptr node = tree;
+        do {
+          if (node == (tchunkptr)chunk)
+            return 1;
+        } while ((node = node->fd) != tree);
+      }
+    }
+  }
+  return 0;
+}
