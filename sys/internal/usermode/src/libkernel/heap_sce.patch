+int HeapCheckTree(mstate m, tchunkptr t) {
+  tchunkptr head = 0;
+  tchunkptr node = t;
+  bindex_t index = t->index;
+  size_t size = chunksize(t);
+  bindex_t expected;
+  compute_tree_index(size, expected);
+  HEAP_CHECK(index == expected);
+  HEAP_CHECK(size >= MIN_LARGE_SIZE);
+  HEAP_CHECK(size >= minsize_for_tree_index(index));
+  HEAP_CHECK(index == NTREEBINS - 1 || size < minsize_for_tree_index(index + 1));
+  do {
+    HEAP_CHECK(!HeapCheckAny(m, (mchunkptr)node));
+    HEAP_CHECK(node->index == index);
+    HEAP_CHECK(chunksize(node) == size);
+    HEAP_CHECK(!cinuse(node));
+    HEAP_CHECK(!next_pinuse(node));
+    HEAP_CHECK(node->fd->bk == node);
+    HEAP_CHECK(node->bk->fd == node);
+    if (node->parent == 0) {
+      HEAP_CHECK(node->child[0] == 0);
+      HEAP_CHECK(node->child[1] == 0);
