+static inline __attribute__((always_inline)) int HeapCheckState(mstate m) {
+  bindex_t index;
+  for (index = 0; index < NSMALLBINS; index++) {
+    sbinptr bin = smallbin_at(m, index);
+    mchunkptr p = bin->bk;
+    int empty = !smallmap_is_marked(m, index);
+    if (p == bin)
+      HEAP_CHECK(empty);
+    if (!empty) {
+      for (; p != bin; p = p->bk) {
+        HEAP_CHECK(!HeapCheckFree(m, p));
+        HEAP_CHECK(small_index(chunksize(p)) == index);
+        HEAP_CHECK(p->bk == bin || chunksize(p->bk) == chunksize(p));
+        mchunkptr next = next_chunk(p);
+        if (next->head != FENCEPOST_HEAD)
+          HEAP_CHECK(!HeapCheckInuse(m, next));
+      }
+    }
+  }
+  for (index = 0; index < NTREEBINS; index++) {
+    tchunkptr tree = *treebin_at(m, index);
+    int empty = !treemap_is_marked(m, index);
+    if (tree == 0)
+      HEAP_CHECK(empty);
+    if (!empty)
+      HEAP_CHECK(!HeapCheckTree(m, tree));
+  }
+  if (m->dvsize != 0) {
+    HEAP_CHECK(!HeapCheckAny(m, m->dv));
+    HEAP_CHECK(m->dvsize == chunksize(m->dv));
+    HEAP_CHECK(m->dvsize >= MIN_CHUNK_SIZE);
+    HEAP_CHECK(!HeapBinFind(m, m->dv));
+  }
+  size_t total = 0;
+  if (m->top != 0) {
+    mchunkptr top = m->top;
+    msegmentptr segment = segment_holding(m, (char *)top);
+    HEAP_CHECK(segment != 0);
+    HEAP_CHECK(!HeapCheckAny(m, top));
+    HEAP_CHECK(chunksize(top) == m->topsize);
+    HEAP_CHECK(m->topsize != 0);
+    HEAP_CHECK(m->topsize == segment->base + segment->size - (char *)top - 0x30);
+    HEAP_CHECK(pinuse(top));
+    HEAP_CHECK(!next_pinuse(top));
+    HEAP_CHECK(!HeapBinFind(m, top));
+    total = m->topsize + 0x30;
+    msegmentptr s = &m->seg;
+    while (s != 0) {
+      mchunkptr p = align_as_chunk(s->base);
+      mchunkptr previous = 0;
+      HEAP_CHECK(pinuse(p));
+      while (segment_holds(s, p) && p != top && p->head != FENCEPOST_HEAD) {
+        total += chunksize(p);
+        if (cinuse(p)) {
+          HEAP_CHECK(!HeapBinFind(m, p));
+          HEAP_CHECK(!HeapCheckInuse(m, p));
+        }
+        else {
+          HEAP_CHECK(p == m->dv || HeapBinFind(m, p));
+          HEAP_CHECK(previous == 0 || cinuse(previous));
+          HEAP_CHECK(!HeapCheckFree(m, p));
+        }
+        previous = p;
+        p = next_chunk(p);
+      }
+      s = s->next;
+    }
+  }
+  HEAP_CHECK(total <= m->footprint);
+  HEAP_CHECK(m->footprint <= m->max_footprint);
+  return 0;
+}
