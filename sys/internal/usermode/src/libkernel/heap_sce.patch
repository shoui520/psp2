+int mspace_malloc_stats(mspace msp, struct MspaceStats *stats) {
+  mstate m = (mstate)msp;
+  flag_t locked = m->mflags & 2;
+  if (locked) {
+    if (sceKernelLockLwMutex(&m->mutex, 1, 0) < 0)
+      ABORT;
+    locked = m->mflags & 2;
+  }
+  int result = HeapCheckState(m);
+  struct MspaceStats value = { 0 };
+  if (result == 0 && (m->top != 0 || malloc_corruption_error_count != 0)) {
+    value.capacity = m->max_footprint;
+    value.footprint = m->footprint;
+    value.peakInUse = m->peak_in_use;
+    value.currentInUse = m->current_in_use;
+    if (m->top != 0) {
+      msegmentptr segment = &m->seg;
+      do {
+        mchunkptr p = align_as_chunk(segment->base);
+        while (segment_holds(segment, p) && p != m->top && p->head != FENCEPOST_HEAD)
+          p = next_chunk(p);
+        segment = segment->next;
+      } while (segment != 0);
+    }
+  }
+  if (locked && sceKernelUnlockLwMutex(&m->mutex, 1) < 0)
+    ABORT;
+  if (result == 0 && stats != 0)
+    *stats = value;
+  return result;
+}
