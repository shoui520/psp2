+/* SCE adaptation of upstream internal_memalign; its public and private native
+   entries share the same inlined algorithm and runtime footer configuration. */
+static inline __attribute__((always_inline))
+void *HeapAlignEngine(mstate m, size_t alignment, size_t bytes) {
+  if ((int)alignment < 0)
+    return 0;
+  if (alignment <= MALLOC_ALIGNMENT)
+    return HeapMallocCall(m, bytes);
+  if ((alignment & (alignment - 1)) != 0) {
+    size_t rounded = MALLOC_ALIGNMENT << 1;
+    while (rounded < alignment)
+      rounded <<= 1;
+    alignment = rounded;
+  }
+  if (bytes >= (size_t)-0x40 - alignment)
+    return 0;
+  size_t overhead = sce_chunk_overhead(m);
+  size_t nb = bytes < 15 - overhead ? MIN_CHUNK_SIZE : sce_pad_request(m, bytes);
+  size_t request = nb + alignment + MIN_CHUNK_SIZE - overhead;
+  char *mem = HeapMallocCall(m, request);
+  if (mem == 0)
+    return 0;
+  void *leader = 0;
+  void *trailer = 0;
+  mchunkptr p = mem2chunk(mem);
+  PREACTION(m);
+  if ((size_t)mem % alignment != 0) {
+    char *aligned = (char *)mem2chunk(((size_t)mem + alignment - 1) & -alignment);
+    char *position = (size_t)(aligned - (char *)p) >= MIN_CHUNK_SIZE ?
+                     aligned : aligned + alignment;
+    mchunkptr newp = (mchunkptr)position;
+    size_t leadsize = position - (char *)p;
+    size_t newsize = chunksize(p) - leadsize;
+    set_inuse(m, newp, newsize);
+    set_inuse(m, p, leadsize);
+    leader = chunk2mem(p);
+    p = newp;
+  }
+  size_t size = chunksize(p);
+  if (size > nb + MIN_CHUNK_SIZE) {
+    size_t remainderSize = size - nb;
+    mchunkptr remainder = chunk_plus_offset(p, nb);
+    set_inuse(m, p, nb);
+    set_inuse(m, remainder, remainderSize);
+    trailer = chunk2mem(remainder);
+  }
+  assert(chunksize(p) >= nb);
+  assert((size_t)chunk2mem(p) % alignment == 0);
+  POSTACTION(m);
+  if (leader != 0)
+    mspace_free(m, leader);
+  if (trailer != 0)
+    mspace_free(m, trailer);
+  return chunk2mem(p);
+}
