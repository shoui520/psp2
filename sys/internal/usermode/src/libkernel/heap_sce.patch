+/* SCE: only reviewed native entry points are selected at this checkpoint. */
+void *sceClibMspaceCreate(void *base, SceSize capacity) {
+  static const struct malloc_params defaults = {
+    0x58585858, 0x10000, 0x10000, (size_t)-1, (size_t)-1, 7
+  };
+  mchunkptr chunk;
+  mstate space;
+  char name[36];
 
+  if (!mparams.page_size)
+    mparams = defaults;
+  if (capacity <= 0x270 || capacity >= (size_t)-(mparams.page_size + 0x270))
+    return 0;
+  chunk = align_as_chunk((char *)base);
+  space = chunk2mem(chunk);
+  /* SCE reserves0x240 state bytes, including unclassified trailing fields. */
+  sceClibMemset(space, 0, 0x240);
+  chunk->head = 0x243;
+  space->seg.base = space->least_addr = base;
+  space->seg.size = space->footprint = space->max_footprint = capacity;
+  space->magic = mparams.magic;
+  space->mflags = mparams.default_mflags | USE_NONCONTIGUOUS_BIT;
+  space->page_size = mparams.page_size;
+  space->granularity = mparams.granularity;
+  space->current_in_use = space->peak_in_use = 0x280;
+  init_bins(space);
+  init_top(space, chunk_plus_offset(chunk, 0x240),
+    ((char *)base + capacity - (char *)chunk) - 0x240 - TOP_FOOT_SIZE);
+  (void)segment_holding(space, (char *)space->top);
+  if (space->mflags & 2) {
+    sceClibSnprintf(name, 0x23, "%s%08X_%08X", "SceLibcMspaceS", capacity,
+      (unsigned int)base);
+    if (sceKernelCreateLwMutex(&space->mutex, name, 0x2002, 0, 0) < 0)
+      return 0;
+  }
+  return space;
+}
