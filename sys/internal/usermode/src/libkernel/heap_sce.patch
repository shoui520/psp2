+/* SCE statistics use the upstream debug traversal as a returning validator,
+   rather than aborting on every failed assertion. Runtime footer bits are
+   masked from chunk sizes and no host mallinfo/stdio interface is exposed. */
+#define HEAP_CHECK(condition) do { if (!(condition)) return 1; } while (0)
+
+static inline __attribute__((always_inline))
+int HeapCheckAny(mstate m, mchunkptr p) {
+  HEAP_CHECK(is_aligned(chunk2mem(p)) || p->head == FENCEPOST_HEAD);
+  HEAP_CHECK(ok_address(m, p));
+  return 0;
+}
+
+static inline __attribute__((always_inline))
+int HeapCheckInuse(mstate m, mchunkptr p) {
+  HEAP_CHECK(!HeapCheckAny(m, p));
+  HEAP_CHECK(cinuse(p));
+  HEAP_CHECK(next_pinuse(p));
+  HEAP_CHECK(pinuse(p) || p->prev_foot == chunksize(prev_chunk(p)));
+  return 0;
+}
+
+static inline __attribute__((always_inline))
+int HeapCheckFree(mstate m, mchunkptr p) {
+  size_t size = chunksize(p);
+  mchunkptr next = chunk_plus_offset(p, size);
+  HEAP_CHECK(!HeapCheckAny(m, p));
+  HEAP_CHECK(!cinuse(p));
+  HEAP_CHECK(!pinuse(next));
+  if (p != m->dv && p != m->top) {
+    HEAP_CHECK(size >= MIN_CHUNK_SIZE);
+    HEAP_CHECK((size & CHUNK_ALIGN_MASK) == 0);
+    HEAP_CHECK(is_aligned(chunk2mem(p)));
+    HEAP_CHECK(next->prev_foot == size);
+    HEAP_CHECK(pinuse(p));
+    HEAP_CHECK(next == m->top || cinuse(next));
+    HEAP_CHECK(p->fd->bk == p);
+    HEAP_CHECK(p->bk->fd == p);
+  }
+  return 0;
