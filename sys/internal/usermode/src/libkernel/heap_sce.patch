+/* SCE replaces host mmap/MORECORE with user kernel memblocks. */
+void *HeapGrow(mstate space, size_t bytes, int growOnly) {
+  size_t size = (space->granularity + TOP_FOOT_SIZE + 1 + bytes) &
+    -space->granularity;
+  char name[36];
+  char *allocated = 0;
+  register char *base __asm__("r11");
+  SceUID id;
+  mchunkptr chunk, remainder;
+  size_t remainderSize;
+
+  /* Native's invalid zero-ID return path retains incoming r11. */
+  __asm__("" : "=r"(base));
+  if (size <= bytes)
+    return 0;
+  if ((void *)space == primaryHeap) {
+    if (heapLimit != (size_t)-1 && heapLimit < space->footprint + size)
+      return 0;
+    id = sceKernelAllocMemBlock("SceLibcMalloc", 0x0c20d060, size, 0);
+  } else {
+    sceClibSnprintf(name, 0x23, "SceLibcMspaceS%08X", (unsigned int)space);
+    id = sceKernelAllocMemBlock(name, 0x0c20d060, size, 0);
+  }
+  if (id < 0)
+    return 0;
+  if (id > 0) {
+    if (sceKernelGetMemBlockBase(id, (void **)&allocated))
+      return 0;
+    ((struct MspaceBackingBlock *)allocated)->encodedId = (SceUInt32)id ^
+      *(SceUInt32 *)sceKernelGetTLSAddr(7);
+    base = allocated;
+  }
+  if (base == CMFAIL)
+    return 0;
+  space->footprint += size;
+  if (space->max_footprint < space->footprint)
+    space->max_footprint = space->footprint;
+  if (!space->top) {
+    space->least_addr = base;
+    space->seg.base = base;
+    space->seg.size = size;
+    space->seg.sflags = 1;
+    init_bins(space);
+    space->current_in_use = 0x40;
+    if (space->peak_in_use < 0x40)
+      space->peak_in_use = 0x40;
+    init_top(space, (mchunkptr)base, size - TOP_FOOT_SIZE);
+  } else {
+    if (base < space->least_addr)
+      space->least_addr = base;
+    space->current_in_use += 0x40;
+    if (space->peak_in_use < space->current_in_use)
+      space->peak_in_use = space->current_in_use;
+    add_segment(space, base, size, 1);
+  }
+  (void)segment_holding(space, (char*)space->top);
+  if (!growOnly && bytes < space->topsize) {
+    remainderSize = space->topsize -= bytes;
+    chunk = space->top;
+    remainder = space->top = chunk_plus_offset(chunk, bytes);
+    remainder->head = remainderSize | PINUSE_BIT;
+    set_size_and_pinuse_of_inuse_chunk(space, chunk, bytes);
+    (void)segment_holding(space, (char*)space->top);
+    base = chunk2mem(chunk);
+  }
+  return base;
+}
