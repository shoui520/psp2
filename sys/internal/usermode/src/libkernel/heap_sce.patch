+/* SCE: release checks are inlined in the native free entry. The non-head
+   record uses the later0x38 reserve while the head retains0x30. */
+static inline __attribute__((always_inline)) void HeapReleaseUnused(mstate m,
+                                                                   mchunkptr p) {
+  if (m->seg.base == 0)
+    return;
+  if (m->seg.next != 0) {
+    size_t mask = m->granularity - 1;
+    if (((size_t)p & mask) != 8 || m->seg.base == (char *)p - 8)
+      return;
+    mchunkptr following = next_chunk(p);
+    size_t followingHead = following->head;
+    if (((size_t)following & mask) != m->granularity - 0x38 ||
+        (followingHead & ~(size_t)7) != 0x20 ||
+        (followingHead & CINUSE_BIT) == 0)
+      return;
+    msegmentptr previous = &m->seg;
+    msegmentptr segment = previous->next;
+    while (segment != 0) {
+      char *base = segment->base;
+      size_t size = segment->size;
+      msegmentptr next = segment->next;
+      flag_t flags = segment->sflags;
+      if ((flags & 0xb) == 1) {
+        mchunkptr first = align_as_chunk(base);
+        if (!cinuse(first) &&
+            (char *)first + chunksize(first) >= base + size - 0x38) {
+          assert(segment_holds(segment, (char *)segment));
+          if (first == m->dv) {
+            m->dv = 0;
+            m->dvsize = 0;
+          }
+          else {
+            tchunkptr tree = (tchunkptr)first;
+            unlink_large_chunk(m, tree);
+          }
+          HeapReleaseBlock(base, size);
+          m->footprint -= size;
+          m->current_in_use -= 0x40;
+          previous->next = next;
+          segment = next;
+          continue;
+        }
+      }
+      previous = segment;
+      segment = next;
+    }
+    if (m->seg.next != 0)
+      return;
+  }
+  if ((m->seg.sflags & 3) == 1) {
+    char *base = m->seg.base;
+    size_t size = m->seg.size;
+    if (base == 0)
+      ABORT;
+    mchunkptr first = align_as_chunk(base);
+    if (!cinuse(first) &&
+        (char *)first + chunksize(first) >= base + size - 0x30) {
+      HeapReleaseBlock(base, size);
+      m->footprint -= size;
+      m->current_in_use -= 0x40;
+      reset_on_error(m);
+    }
+  }
+}
