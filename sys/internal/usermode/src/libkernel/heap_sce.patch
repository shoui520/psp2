+      if (node->child[1] != 0) {
+        HEAP_CHECK(node->child[1]->parent == node);
+        HEAP_CHECK(node->child[1] != node);
+        HEAP_CHECK(!HeapCheckTree(m, node->child[1]));
+      }
+      if (node->child[0] != 0 && node->child[1] != 0)
+        HEAP_CHECK(chunksize(node->child[0]) < chunksize(node->child[1]));
+    }
