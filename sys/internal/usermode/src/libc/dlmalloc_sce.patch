+/* SCE: whether only the space's own bookkeeping is in use */
+static int is_heap_empty(mstate m) {
+  size_t used = 0;
+  flag_t footers;
+  PREACTION(m);
+  footers = m->mflags & USE_FOOTERS_BIT;
+  if ((malloc_corruption_error_count | (size_t)m->top) != 0)
+    used = m->current_in_use;
+  else if (heapNotExtended && !heapDelayedAlloc)
+    used = SEGMENT_IN_USE_OF(footers);
+  POSTACTION(m);
+  if (is_global(m))
+    return used == 0 || used == SEGMENT_IN_USE_OF(footers);
+  return used == SEGMENT_IN_USE_OF(footers) +
+    pad_request_of(footers, sizeof(struct malloc_state));
