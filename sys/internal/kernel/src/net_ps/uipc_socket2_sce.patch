 /*
+ * SCE: wake processes waiting on a socket buffer to give up the wait: canceled,
+ * or interrupted by an address change or an abort; 15 when nothing waits
+ */
+int
+soabortwakeup(struct socket *so, struct sockbuf *sb, int code, int addressChanged)
+{
+	sceNetPsWakeupEpolls(so);
+	sb->sb_flags &= ~SB_SEL;
+	if (sb->sb_flags & SB_WAIT) {
+		sb->sb_flags &= ~SB_WAIT;
+		if (sb->sb_flags & SB_NOINTR)
+			return (sceNetPsWakeupCanceled(&sb->sb_cc));
+		if (addressChanged)
+			return (sceNetPsWakeupAddressChanged(&sb->sb_cc));
+		return (sceNetPsWakeupInterrupted(&sb->sb_cc));
+	}
+	return (15);
+}
