+#define	SO_TPPOLICY	0x1101		/* SCE: thread priority policy (SCE_NET_SO_TPPOLICY) */
+#define	SO_NAME		0x1102		/* SCE: debug name (SCE_NET_SO_NAME) */
+#define	SO_REPORTEDPROCESS 0x1103	/* SCE: so->reportedProcessOverride; no SDK name */
+#define	SO_ERROR_EX	0x1104		/* SCE: error as an SCE error code (SCE_NET_SO_ERROR_EX) */
