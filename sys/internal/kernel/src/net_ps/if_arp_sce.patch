 /*
+ * SCE: the ARP socket.  Every ARP packet received is handed to its sockets,
+ * and an address added on one sends a gratuitous ARP request for it.
+ */
+void
+arpsock_init()
+{
+
+	in_pcbinit(&arpcbtable, 1, 1);
+}
+
+int
+arpsock_input(m)
+	struct mbuf *m;
+{
+	struct inpcb_hdr *inph;
+	struct inpcb *inp;
+	struct sockaddr_in sin;
+	struct mbuf *n;
+
+	memset(&sin, 0, sizeof(sin));
+	sin.sin_family = AF_INET;
+	sin.sin_len = sizeof(sin);
+	CIRCLEQ_FOREACH(inph, &arpcbtable.inpt_queue, inph_queue) {
+		inp = (struct inpcb *)inph;
+		if ((inp->inp_flags & INP_CONTROLOPTS) == 0)
+			continue;
+		if ((n = m_copym(m, 0, M_COPYALL, M_DONTWAIT)) == NULL)
+			continue;
+		if (sbappendaddr(&inp->inp_socket->so_rcv, sintosa(&sin), n,
+		    NULL) == 0) {
+			m_freem(n);
+			continue;
+		}
+		sorwakeup(inp->inp_socket);
+	}
+	return (0);
+}
+
+int
+arpsock_usrreq(so, req, m, nam, control, p)
+	struct socket *so;
+	int req;
+	struct mbuf *m, *nam, *control;
+	struct proc *p;
+{
+	struct in_aliasreq *ifra;
+	struct ifnet *ifp;
+	struct inpcb *inp;
+	int error;
+
+	if (req == PRU_CONTROL) {
+		if ((u_long)m != SIOCAIFADDR)
+			return (EINVAL);
+		ifra = (struct in_aliasreq *)nam;
+		ifp = (struct ifnet *)control;
+		arprequest(ifp, &ifra->ifra_addr.sin_addr,
+		    &ifra->ifra_dstaddr.sin_addr, LLADDR(ifp->if_sadl),
+		    so != NULL && (so->so_options & SO_SCE_OPTION_10000));
+		return (0);
+	}
+	inp = sotoinpcb(so);
+	switch (req) {
+
+	case PRU_ATTACH:
+		if (inp != NULL)
+			return (EISCONN);
+		if (p == 0)
+			return (EACCES);
+		if ((error = soreserve(so, 512, 512)) != 0)
+			return (error);
+		if ((error = in_pcballoc(so, &arpcbtable)) != 0)
+			return (error);
+		inp = sotoinpcb(so);
+		inp->inp_ip.ip_p = (long)nam;
+		inp->inp_flags = INP_CONTROLOPTS;
+		return (0);
+
+	case PRU_DETACH:
+		in_pcbdetach(inp);
+		return (0);
+
+	default:
+		return (EOPNOTSUPP);
+	}
+}
