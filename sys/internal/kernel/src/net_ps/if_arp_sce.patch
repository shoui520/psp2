+/*
+ * SCE: the raw Ethernet (ISDN) socket.  It sends whole Ethernet frames out of
+ * the multicast interface or the first broadcast interface that is up, and
+ * receives the frames of its ether type (every frame for type 0).
+ */
+int
+isdn_output(m, so, withsrc)
+	struct mbuf *m;
+	struct socket *so;
+	int withsrc;
+{
+	struct inpcb *inp = sotoinpcb(so);
+	struct ifnet *ifp;
+	struct ether_header *eh;
+	union {
+		struct sockaddr sa;
+		u_int8_t data[32];	/* the header, the source at sa_data[16] */
+	} dst;
+	int error;
+
+	if (inp->inp_moptions == NULL ||
+	    (ifp = inp->inp_moptions->imo_multicast_ifp) == NULL) {
+		TAILQ_FOREACH(ifp, &ifnet, if_list) {
+			if (ifp->if_flags & (IFF_LOOPBACK|IFF_POINTOPOINT))
+				continue;
+			if (ifp->if_flags & IFF_UP)
+				break;
+		}
+		if (ifp == NULL) {
+			error = ENETUNREACH;
+			goto release;
+		}
+	}
+	if ((error = sceNetPsCheckDisabledInterface(m, ifp, so)) != 0)
+		goto release;
+	eh = mtod(m, struct ether_header *);
+	dst.sa.sa_len = sizeof(dst.sa);
+	dst.sa.sa_family = AF_UNSPEC;
+	memcpy(dst.sa.sa_data, eh, ETHER_HDR_LEN);
+	if (withsrc) {
+		dst.sa.sa_len = sizeof(dst);
+		memcpy(&dst.data[18], eh->ether_shost, ETHER_ADDR_LEN);
+	}
+	m_adj(m, ETHER_HDR_LEN);
+	sceNetPsFilterTxSocket(m, ifp, inp->inp_socket);
+	sceNetPsSetNoAutoConnect(m, ifp, inp->inp_socket);
+	error = (*ifp->if_output)(ifp, m, &dst.sa, NULL);
+	m = NULL;
+release:
+	m_freem(m);
+	return (error);
+}
+
+void
+isdn_init()
+{
+
+	in_pcbinit(&isdncbtable, 1, 1);
+}
+
+int
+isdn_input(m)
+	struct mbuf *m;
+{
+	struct inpcb_hdr *inph;
+	struct inpcb *inp;
+	struct ether_header *eh;
+	union {
+		struct sockaddr_in sin;
+		u_int8_t data[20];	/* the addresses at sin_zero */
+	} src;
+	struct mbuf *n;
+
+	memset(&src, 0, sizeof(src));
+	src.sin.sin_family = AF_INET;
+	src.sin.sin_len = sizeof(src);
+	/* the Ethernet header back in front */
+	m->m_len += ETHER_HDR_LEN;
+	m->m_data -= ETHER_HDR_LEN;
+	if (m->m_flags & M_PKTHDR)
+		m->m_pkthdr.len += ETHER_HDR_LEN;
+	eh = mtod(m, struct ether_header *);
+	memcpy(src.sin.sin_zero, eh, 2 * ETHER_ADDR_LEN);
+	CIRCLEQ_FOREACH(inph, &isdncbtable.inpt_queue, inph_queue) {
+		inp = (struct inpcb *)inph;
+		if (inp->inp_ip.ip_id != 0 &&
+		    inp->inp_ip.ip_id != ntohs(eh->ether_type))
+			continue;
+		if ((m->m_flags & M_SCE_EMULATION_DROP) &&
+		    sceNetPsFilterRxSocket(m, m->m_pkthdr.rcvif,
+		    inp->inp_socket))
+			continue;
+		if ((inp->inp_flags & INP_CONTROLOPTS) == 0)
+			continue;
+		if ((n = m_copym(m, 0, M_COPYALL, M_DONTWAIT)) == NULL)
+			continue;
+		if (sbappendaddr(&inp->inp_socket->so_rcv,
+		    (struct sockaddr *)&src, n, NULL) == 0) {
+			m_freem(n);
+			continue;
+		}
+		sorwakeup(inp->inp_socket);
+	}
+	return (0);
+}
+
+int
+isdn_usrreq(so, req, m, nam, control, p)
+	struct socket *so;
+	int req;
+	struct mbuf *m, *nam, *control;
+	struct proc *p;
+{
+	struct inpcb *inp;
+	int error;
+
+	if (req == PRU_CONTROL)
+		return (EINVAL);
+	inp = sotoinpcb(so);
+	switch (req) {
+
+	case PRU_ATTACH:
+		if (inp != NULL) {
+			error = EISCONN;
+			break;
+		}
+		if (p == 0) {
+			error = EACCES;
+			break;
+		}
+		if ((error = soreserve(so, 2048, 2048)) != 0)
+			break;
+		if ((error = in_pcballoc(so, &isdncbtable)) != 0)
+			break;
+		inp = sotoinpcb(so);
+		inp->inp_ip.ip_id = (long)nam;
+		inp->inp_flags = INP_CONTROLOPTS;
+		so->so_state |= SS_ISCONNECTED | SS_ISDISCONNECTING;
+		break;
+
+	case PRU_DETACH:
+		in_pcbdetach(inp);
+		break;
+
+	case PRU_SEND:
+		if (control && control->m_len) {
+			m_freem(control);
+			m_freem(m);
+			error = EINVAL;
+			break;
+		}
+		error = isdn_output(m, so, 1);
+		break;
+
+	case PRU_SENDOOB:
+		if (control && control->m_len) {
+			m_freem(control);
+			m_freem(m);
+			error = EINVAL;
+			break;
+		}
+		error = isdn_output(m, so, 0);
+		break;
+
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	return (error);
+}
