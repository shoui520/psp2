+/*
+ * SCE: free every packet an entry holds, oldest first; the count freed.
+ */
+static int
+arp_hold_drain(la)
+	struct llinfo_arp *la;
+{
+	int i, j, count = 0;
+
+	for (i = 0; i < LA_HOLD_MAX; i++) {
+		j = (la->la_holdnext + i) % LA_HOLD_MAX;
+		if (la->la_hold[j]) {
+			count++;
+			m_freem(la->la_hold[j]);
+			la->la_hold[j] = NULL;
+		}
+	}
+	return (count);
+}
