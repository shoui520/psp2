 /*
+ * SCE: hold a packet until the address is resolved, in place of the oldest
+ * one when the ring is full; 1 if one was freed.
+ */
+static __inline int
+arp_hold_enqueue(la, m)
+	struct llinfo_arp *la;
+	struct mbuf *m;
+{
+	int dropped = 0;
+
+	if (la->la_hold[la->la_holdnext]) {
+		m_freem(la->la_hold[la->la_holdnext]);
+		dropped = 1;
+	}
+	la->la_hold[la->la_holdnext] = m;
+	la->la_holdnext = (la->la_holdnext + 1) % LA_HOLD_MAX;
+	return (dropped);
+}
+
+/*
+ * SCE: send every packet an entry holds, oldest first; the count sent.
+ */
+static __inline int
+arp_hold_send(la, ifp, rt)
+	struct llinfo_arp *la;
+	struct ifnet *ifp;
+	struct rtentry *rt;
+{
+	int i, j, count = 0;
+
+	for (i = 0; i < LA_HOLD_MAX; i++) {
+		j = (la->la_holdnext + i) % LA_HOLD_MAX;
+		if (la->la_hold[j]) {
+			count++;
+			(*ifp->if_output)(ifp, la->la_hold[j], rt_key(rt), rt);
+			la->la_hold[j] = NULL;
+		}
+	}
+	return (count);
+}
