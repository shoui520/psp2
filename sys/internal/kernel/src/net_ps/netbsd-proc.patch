--- contrib/netbsd-2.1/sys/sys/proc.h
+++ sys/internal/kernel/src/net_ps/include/sys/proc.h
@@ -391,6 +391,9 @@
 	return l->l_proc;
 }
 #define	curproc	__curproc()
+/* SCE: in net_ps, the current process is a variable, as in NetBSD 1.x */
+#undef	curproc
+extern struct proc	*curproc;
 
 extern struct proc	proc0;		/* Process slot for swapper */
 extern int		nprocs, maxproc; /* Current and max number of procs */
@@ -479,6 +482,18 @@
 /* Compatibility with old, non-interlocked tsleep call */
 #define	tsleep(chan, pri, wmesg, timo)					\
 	ltsleep(chan, pri, wmesg, timo, NULL)
+#ifdef NET_PS_NETBSD
+/*
+ * SCE: in NetBSD's own files (NET_PS_NETBSD, set by the build), a sleep is net_ps's, without
+ * NetBSD's priority (sbwait, sb_lock), and a wakeup is net_ps's normal one
+ */
+int	sceNetPsSleep(const void *, unsigned int, const char *, int);
+int	sceNetPsWakeupNormal(const void *);
+#undef	tsleep
+#define	tsleep(chan, pri, wmesg, timo)					\
+	sceNetPsSleep((chan), 0, (wmesg), (timo))
+#define	wakeup(chan)	sceNetPsWakeupNormal(chan)
+#endif
 
 #if defined(MULTIPROCESSOR)
 void	proc_trampoline_mp(void);	/* XXX */
