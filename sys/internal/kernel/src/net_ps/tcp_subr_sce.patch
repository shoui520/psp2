+/*
+ * SCE: drop every P2P connection to a peer udpp2p forgets (its address and
+ * virtual port in sin).
+ */
+void
+tcp_drop_peer(struct sockaddr_in *sin)
+{
+	struct inpcb_hdr *inph;
+	struct inpcb *inp;
+	struct tcpcb *tp;
+
+	CIRCLEQ_FOREACH(inph, &tcbtable.inpt_queue, inph_queue) {
+		if (inph->inph_af != AF_INET)
+			continue;
+		tp = intotcpcb((struct inpcb *)inph);
+		if (tp == NULL)
+			continue;
+		inp = tp->t_inpcb;
+		if (inp == NULL || (tp->t_flags & TF_SCE_P2P) == 0)
+			continue;
+		if (in_hosteq(inp->inp_faddr, sin->sin_addr) &&
+		    tp->t_remote_vport == sin->sin_port)
+			(void) tcp_drop(tp, ECONNRESET);
+	}
