+int mspace_verify_all_chunk(mspace msp, const char* name, void* mem) {
+  mstate m = (mstate)msp;
+  int count = 0;
+  int notfound = 1;
+  uintptr_t pa;
+  ensure_initialization();
+  if (!PREACTION(m)) {
+    if (is_initialized(m)) {
+      msegmentptr s = &m->seg;
+      int found = 0;
+      while (s != 0) {
+        mchunkptr first = align_as_chunk(s->base);
+        mchunkptr q = first;
+        while (segment_holds(s, q) &&
+               q != m->top && q->head != FENCEPOST_HEAD) {
+          if (is_inuse(q)) {
+            if (q != first) {
+              mstate fm = get_mstate_for(q);
+              if (sceKernelVAtoPA(fm, &pa) < 0) {
+                SCE_PRINTF_WITH_INFO(0, 3603,
+                  "*** Kernel Heap Corruption. BAD ADDRESS (msp=%p[%s], q=%p, fm=%p)\n",
+                  m, name, q, fm);
+                return SCE_DLMALLOC_ERROR_BAD_CHUNK;
+              }
+              if (!ok_magic(fm))
+                SCE_PRINTF_WITH_INFO(0, 3608,
+                  "*** Kernel Heap Corruption. BAD MAGIC (msp=%p[%s], q=%p)\n",
+                  m, name, q);
+            }
+            count++;
+            if (chunk2mem(q) == mem)
+              found = 1;
+          }
+          else if (chunk2mem(q) == mem) {
+            SCE_DBG_PRINTF_LEVEL(1, 0, 3621,
+              "*** Kernel Heap Possibility of double free (msp=%p[%s], ptr=q=%p)\n",
+              m, name, q);
+          }
+          q = next_chunk(q);
+          if ((char*)q < s->base)
+            break;
+        }
+        s = s->next;
+      }
+      notfound = !found;
+    }
+    POSTACTION(m);
+  }
+  if (mem != 0 && notfound &&
+      (!ok_address(m, mem2chunk(mem)) || (mem2chunk(mem)->head & INUSE_BITS) != 0)) {
+    SCE_DBG_PRINTF_LEVEL(1, 0, 3644,
+      "*** Kernel Heap Invalid operation (msp=%p[%s], ptr=%p)\n", m, name, mem);
+    count = SCE_DLMALLOC_ERROR_BAD_CHUNK;
+  }
+  return count;
+}
